{
  "name": "astro-elesoltree",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "admin": "node scripts/admin.mjs",
    "prebuild": "node scripts/sync-media.mjs && node scripts/sync-admin-assets.mjs",
    "predev": "node scripts/sync-admin-assets.mjs",
    "precheck": "node scripts/sync-admin-assets.mjs",
    "content:backup": "node scripts/content-backup.mjs",
    "content:pull": "node scripts/content-sync.mjs pull",
    "content:push": "node scripts/content-sync.mjs push",
    "verify:content-sync": "node scripts/verify-content-sync.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "admin:online:check": "node scripts/admin-online-setup.mjs",
    "admin:online:prepare": "node scripts/admin-online-setup.mjs --prepare-storage",
    "verify:online-admin": "node scripts/verify-admin-auth-proxy.mjs && node scripts/verify-admin-store.mjs && node scripts/verify-admin-content.mjs && node scripts/verify-admin-publish.mjs && node scripts/verify-online-admin-ui.mjs && node scripts/verify-admin-online-setup.mjs && node scripts/verify-admin-navigation.mjs && node scripts/verify-analytics-navigation.mjs",
    "verify:online-admin:runtime": "node --no-experimental-require-module scripts/verify-online-admin-runtime.mjs",
    "verify:products": "node scripts/verify-product-admin.mjs",
    "verify:rich-article": "node scripts/verify-rich-article.mjs",
    "verify:product-gallery": "node scripts/verify-product-gallery.mjs",
    "verify:taxonomy": "node scripts/verify-taxonomy.mjs",
    "verify:taxonomy:live": "node scripts/verify-taxonomy-live.mjs",
    "verify:analytics": "node scripts/verify-analytics.mjs && node scripts/verify-analytics-navigation.mjs && node scripts/verify-gsc.mjs",
    "verify:seo": "node scripts/verify-seo-diagnostics.mjs && node scripts/verify-seo-admin.mjs && node scripts/verify-seo-research.mjs && node scripts/verify-analytics-navigation.mjs",
    "verify:ai-settings": "node scripts/verify-ai-settings.mjs && node scripts/verify-analytics-navigation.mjs",
    "verify:topic-planning": "node scripts/verify-topic-planning.mjs && node scripts/verify-analytics-navigation.mjs",
    "verify:deploy": "node scripts/verify.mjs && node scripts/check-built-images.mjs && node scripts/verify-contact-runtime.mjs && node scripts/verify-vercel-build.mjs && npm run verify:online-admin:runtime",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/vercel": "11.0.16",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "7.4.2",
    "google-auth-library": "11.3.2",
    "jodit": "4.18.12",
    "sanitize-html": "2.18.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "decap-cms": "3.17.3",
    "decap-server": "3.11.6",
    "history": "4.10.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "^5.7.0"
  }
}
