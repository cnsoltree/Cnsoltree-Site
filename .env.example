RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cnsoltree.com
RESEND_ADMIN_EMAIL=shawn@cnsoltree.com
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Online AI settings: stable 32 random bytes encoded as base64. Keep only on the server.
# Apply supabase/migrations/202610290001_ai_settings.sql before enabling cloud settings.
AI_SETTINGS_ENCRYPTION_KEY=

# Enable only after applying the Supabase migration, creating the confirmed admin account,
# preparing the private media bucket and configuring a repository-scoped publishing token.
ADMIN_ONLINE_ENABLED=false
ADMIN_GITHUB_TOKEN=

# Private, readonly Google Search Console integration. JSON must never be committed.
GSC_PROPERTY=sc-domain:elesoltree.com
GSC_SERVICE_ACCOUNT_JSON=

# Optional local SEO web research. Choose a model supporting web_search and structured outputs.
# These values remain on the server. Leave blank to use local planning without API calls.
SEO_OPENAI_API_KEY=
SEO_OPENAI_MODEL=
