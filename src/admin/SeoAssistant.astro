---
---

<main
  id="studio-seo"
  class="product-manager seo-manager"
  aria-labelledby="seo-assistant-title"
  hidden
  inert
>
  <div class="product-page-heading">
    <div>
      <h1 id="seo-assistant-title">SEO 助手</h1>
      <p>先整理资料与选题，再将确认后的主题转为写作任务。</p>
    </div>
    <button type="button" class="product-refresh" data-seo-refresh>
      刷新数据
    </button>
  </div>
  <p class="product-error" data-seo-error role="alert" hidden></p>
  <p class="seo-feedback" data-seo-feedback role="status" aria-live="polite"></p>
  <section class="product-panel">
    <div class="seo-tabs" role="tablist" aria-label="SEO 工作流程">
      <button
        id="seo-planning-tab"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="seo-planning-panel"
        data-seo-tab="planning"
      >
        内容规划
      </button>
      <button
        id="seo-tasks-tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="seo-tasks-panel"
        data-seo-tab="tasks"
        tabindex="-1"
      >
        写作任务 <span data-seo-task-count></span>
      </button>
      <button
        id="seo-diagnostics-tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="seo-diagnostics-panel"
        data-seo-tab="diagnostics"
        tabindex="-1"
      >
        基础诊断
      </button>
    </div>
    <div
      id="seo-planning-panel"
      role="tabpanel"
      aria-labelledby="seo-planning-tab"
      data-seo-panel="planning"
    >
      <form class="seo-planning-form" data-seo-planning-form>
        <div class="seo-form-grid">
          <label class="seo-field">
            <span>一级分类</span>
            <select name="groupSlug" data-seo-group required>
              <option value="">请选择分类</option>
            </select>
          </label>
          <label class="seo-field">
            <span>二级分类</span>
            <select name="topicSlug" data-seo-topic>
              <option value="">全部二级分类</option>
            </select>
          </label>
          <label class="seo-field">
            <span>候选数量</span>
            <input name="count" type="number" min="1" max="30" value="8" required />
          </label>
          <label class="seo-field seo-field-wide">
            <span>目标客户（选填）</span>
            <input
              name="audience"
              type="text"
              maxlength="300"
              placeholder="例如：电气经销商、OEM 采购、光伏安装商"
            />
          </label>
          <label class="seo-field">
            <span>内容语言</span>
            <select name="language">
              <option value="en">English</option>
              <option value="zh">中文</option>
            </select>
          </label>
          <label class="seo-field">
            <span>业务目标（选填）</span>
            <input name="goal" type="text" maxlength="500" placeholder="例如：获得 OEM 采购询盘" />
          </label>
          <label class="seo-field seo-field-wide">
            <span>内容方向（选填）</span>
            <input
              name="direction"
              type="text"
              maxlength="200"
              placeholder="例如：产品选型、对比、应用或采购问题"
            />
          </label>
        </div>
        <div class="seo-planning-actions">
          <button type="submit" class="product-create" data-seo-generate>
            生成候选框架
          </button>
          <button type="button" class="seo-secondary" data-seo-copy-research>
            复制调研需求
          </button>
          <span class="seo-provider-status" data-seo-provider-status>
            正在读取配置…
          </span>
        </div>
        <p class="seo-note">
          本地框架仅使用已启用、已确认的知识资料及现有产品内容；候选主题仍需调研，不代表真实搜索量或竞争难度。
        </p>
      </form>
      <div class="seo-batch-heading">
        <div>
          <h2>候选主题</h2>
          <p data-seo-batch-description>选择分类生成候选，历史批次会保留。</p>
        </div>
        <label class="seo-field seo-batch-select">
          <span>历史批次</span>
          <select data-seo-batch>
            <option value="">暂无批次</option>
          </select>
        </label>
      </div>
      <div class="seo-selection-actions">
        <span data-seo-selected-count>尚未加载</span>
        <button type="button" class="seo-secondary" data-seo-research disabled>
          联网调研
        </button>
        <button type="button" class="product-create" data-seo-build-tasks disabled>
          生成写作任务
        </button>
      </div>
      <p class="seo-note seo-research-note">
        执行联网调研时，仅所选主题及已确认资料会发送至你配置的调研服务。
      </p>
      <div
        class="product-table-scroll seo-table-scroll"
        tabindex="0"
        aria-label="候选主题表格，可横向滚动"
      >
        <table class="product-table seo-candidate-table" aria-label="候选主题">
          <colgroup>
            <col class="seo-column-check" />
            <col class="seo-column-title" />
            <col class="seo-column-keyword" />
            <col class="seo-column-intent" />
            <col class="seo-column-format" />
            <col class="seo-column-update" />
            <col class="seo-column-reason" />
            <col class="seo-column-status" />
            <col class="seo-column-sources" />
            <col class="seo-column-actions" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">
                <input
                  type="checkbox"
                  data-seo-select-all
                  aria-label="选择当前批次全部候选"
                  disabled
                />
              </th>
              <th scope="col">候选标题</th>
              <th scope="col">核心关键词</th>
              <th scope="col">搜索意图</th>
              <th scope="col">建议类型</th>
              <th scope="col">新建 / 更新</th>
              <th scope="col">推荐理由</th>
              <th scope="col">调研状态</th>
              <th scope="col">资料来源</th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody data-seo-candidate-rows>
            <tr>
              <td colspan="10" class="product-empty">
                正在加载内容规划…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div
      id="seo-tasks-panel"
      role="tabpanel"
      aria-labelledby="seo-tasks-tab"
      data-seo-panel="tasks"
      hidden
    >
      <div class="seo-section-heading">
        <div>
          <h2>写作任务</h2>
          <p>查看任务 brief 后开始撰写；任务不会自动创建或发布文章。</p>
        </div>
        <label class="seo-field">
          <span>任务状态</span>
          <select data-seo-task-filter>
            <option value="">全部任务</option>
            <option value="todo">待处理</option>
            <option value="in_progress">写作中</option>
            <option value="done">已完成</option>
          </select>
        </label>
      </div>
      <div
        class="product-table-scroll seo-table-scroll"
        tabindex="0"
        aria-label="写作任务表格，可横向滚动"
      >
        <table class="product-table seo-task-table" aria-label="写作任务">
          <colgroup>
            <col class="seo-task-title" />
            <col class="seo-column-format" />
            <col class="seo-task-category" />
            <col class="seo-task-status" />
            <col class="seo-task-date" />
            <col class="seo-task-actions" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">任务</th>
              <th scope="col">内容类型</th>
              <th scope="col">关联分类</th>
              <th scope="col">任务状态</th>
              <th scope="col">创建时间</th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody data-seo-task-rows>
            <tr>
              <td colspan="6" class="product-empty">
                正在加载写作任务…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div
      id="seo-diagnostics-panel"
      role="tabpanel"
      aria-labelledby="seo-diagnostics-tab"
      data-seo-panel="diagnostics"
      hidden
    >
      <div class="seo-section-heading">
        <div>
          <h2>本地基础检查</h2>
          <p>仅检查现有内容与元数据；结果用于整理待办，不代替搜索引擎抓取报告。</p>
        </div>
      </div>
      <div class="seo-diagnostic-summary" data-seo-diagnostic-summary></div>
      <div class="seo-search-unavailable">
        <span class="seo-status seo-status-muted">GSC 未接入</span>
        <p>当前无法判断真实搜索表现、索引状态或流量。没有数据不代表没有流量或未被收录。</p>
      </div>
      <div
        class="product-table-scroll seo-table-scroll"
        tabindex="0"
        aria-label="本地检查结果，可横向滚动"
      >
        <table class="product-table seo-diagnostic-table" aria-label="本地基础检查">
          <thead>
            <tr>
              <th scope="col">检查项</th>
              <th scope="col">内容</th>
              <th scope="col">说明</th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody data-seo-diagnostic-rows>
            <tr>
              <td colspan="4" class="product-empty">
                正在读取本地检查…
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <dialog
    class="product-delete-dialog seo-dialog"
    data-seo-dialog
    aria-labelledby="seo-dialog-title"
  >
    <form data-seo-dialog-form>
      <h2 id="seo-dialog-title"></h2>
      <fieldset data-seo-dialog-fields></fieldset>
      <p class="product-error" data-seo-dialog-error role="alert" hidden></p>
      <div class="product-dialog-actions">
        <button type="button" data-seo-dialog-cancel>
          关闭
        </button>
        <button type="submit" class="seo-dialog-submit" data-seo-dialog-save>
          保存
        </button>
      </div>
    </form>
  </dialog>
</main>
