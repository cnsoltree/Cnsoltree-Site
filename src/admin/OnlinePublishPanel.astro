---
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<section
  class="online-publish"
  data-online-publish
  data-email={email}
  aria-label="云端保存与网站发布"
>
  <span class="publish-state" role="status" aria-live="polite">
    <span class="publish-dot" aria-hidden="true"></span>
    <span data-publish-summary></span>
  </span>
  <span class="publish-error-summary" data-publish-error role="alert" hidden></span>
  <a class="publish-login" href="/admin/login" data-publish-login hidden>
    重新登录
  </a>
  <button type="button" class="publish-retry" data-publish-refresh hidden>
    重试
  </button>

  <button type="button" class="publish-trigger" data-publish-open disabled>
    发布到网站
  </button>
  <div class="publish-account">
    <span title={email}>{email}</span>
    <button type="button" data-admin-logout>
      退出登录
    </button>
  </div>
  <dialog class="publish-dialog" data-publish-dialog aria-labelledby="publish-dialog-title">
    <h2 id="publish-dialog-title">发布到正式网站？</h2>
    <p>仅发布已保存到云端且开启前台显示的内容；尚未保存的编辑不会包含。是否继续？</p>
    <p class="publish-error" data-publish-dialog-error role="alert" hidden></p>
    <div class="publish-dialog-actions">
      <button type="button" data-publish-cancel autofocus>
        取消
      </button>
      <button type="button" class="publish-confirm" data-publish-confirm>
        确认发布
      </button>
    </div>
  </dialog>
</section>
<script>
  import './online-publish.js';
</script>

<style>
  .publish-error-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .publish-retry {
    padding: 0;
    border: 0;
    background: transparent;
    color: #318664;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .online-publish:has(.publish-error-summary:not([hidden])) .publish-state {
    color: #a36250;
  }
  .online-publish {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    color: #577464;
    font: inherit;
    font-size: 12px;
  }
  .online-publish[hidden],
  [hidden] {
    display: none !important;
  }
  .publish-state {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #647f70;
    font-size: 11px;
    list-style: none;
    white-space: nowrap;
  }
  .publish-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8aa999;
  }
  .online-publish[data-status='queued'] .publish-dot,
  .online-publish[data-status='building'] .publish-dot {
    background: #d1ae63;
  }
  .online-publish[data-status='ready'] .publish-dot {
    background: #31aa80;
  }
  .online-publish[data-status='error'] .publish-dot {
    background: #d07a6b;
  }

  .publish-dialog h2 {
    margin: 0 0 16px;
    color: #345b43;
    font-size: 16px;
  }
  .publish-account button,
  .publish-login {
    border: 0;
    padding: 0;
    background: transparent;
    color: #318664;
    font: inherit;
    font-size: 11px;
    text-decoration: none;
    cursor: pointer;
  }
  .publish-trigger {
    min-height: 34px;
    padding: 8px 12px;
    border: 1px solid #249872;
    border-radius: 8px;
    background: #249872;
    color: #fff;
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
  }
  .publish-account {
    display: grid;
    gap: 5px;
    max-width: 150px;
    font-size: 10px;
  }
  .publish-account > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .publish-account button {
    text-align: left;
  }
  .publish-dialog {
    width: min(430px, calc(100% - 36px));
    padding: 27px;
    border: 1px solid #fff;
    border-radius: 17px;
    background: #f7fcf8;
    color: #617966;
    box-shadow: 0 20px 80px #264b4b30;
  }
  .publish-dialog::backdrop {
    background: #263e4155;
    backdrop-filter: blur(3px);
  }
  .publish-dialog p {
    margin: 0;
    font-size: 12px;
    line-height: 1.9;
  }
  .publish-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 11px;
    margin-top: 23px;
  }
  .publish-dialog-actions button {
    padding: 9px 14px;
    border: 1px solid #d9e7dd;
    border-radius: 7px;
    background: #fff;
    color: #627d6b;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .publish-dialog-actions .publish-confirm {
    border-color: #249872;
    background: #249872;
    color: #fff;
  }

  .publish-dialog .publish-error {
    margin-top: 13px;
    padding: 10px 12px;
    border: 1px solid #efd5cb;
    border-radius: 6px;
    background: #fff1ec;
    color: #a36250;
    font-size: 11px;
    line-height: 1.8;
  }
  .publish-login {
    display: inline-block;
    margin-top: 10px;
  }
  button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  :is(button, a, summary):focus-visible {
    outline: 2px solid #6ac09e;
    outline-offset: 3px;
  }
  @media (max-width: 1100px) {
    .publish-account > span {
      display: none;
    }
  }
  @media (max-width: 750px) {
    .publish-state [data-publish-summary] {
      max-width: 68px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .online-publish {
      gap: 10px;
    }
    .publish-trigger {
      padding: 8px 9px;
      font-size: 11px;
    }
  }
</style>
