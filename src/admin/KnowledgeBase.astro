---
---

<main
  id="studio-knowledge"
  class="product-manager seo-manager knowledge-manager"
  aria-labelledby="knowledge-title"
  hidden
  inert
>
  <div class="product-page-heading">
    <div>
      <h1 id="knowledge-title">知识库</h1>
      <p>保存产品资料、客户问题与业务信息，为选题和写作提供可靠依据。</p>
    </div>
    <button type="button" class="product-refresh" data-knowledge-refresh>
      刷新资料
    </button>
  </div>
  <p class="product-error" data-knowledge-error role="alert" hidden></p>
  <p class="seo-feedback" data-knowledge-feedback role="status" aria-live="polite"></p>
  <section class="product-panel" aria-label="知识资料列表">
    <div class="product-toolbar seo-knowledge-toolbar">
      <button type="button" class="product-create" data-knowledge-create>
        <span aria-hidden="true">＋</span> 添加资料
      </button>
      <button type="button" class="seo-secondary" data-knowledge-import>
        导入文本
      </button>
      <input
        type="file"
        accept=".txt,.md,.csv,text/plain,text/markdown,text/csv"
        data-knowledge-file
        hidden
      />
      <p class="seo-note">支持 TXT、Markdown、CSV 原文导入；暂不提取 PDF 内容。</p>
    </div>
    <div class="product-filters seo-knowledge-filters">
      <label class="product-filter">
        <span>一级分类</span>
        <select data-knowledge-group>
          <option value="">全部分类</option>
          <option value="__shared">全站共用</option>
        </select>
      </label>
      <label class="product-filter">
        <span>二级分类</span>
        <select data-knowledge-topic>
          <option value="">全部二级分类</option>
        </select>
      </label>
      <label class="product-filter product-search">
        <span>查找资料</span>
        <input
          type="search"
          data-knowledge-search
          placeholder="输入标题或资料正文"
          maxlength="256"
        />
      </label>
      <label class="product-filter">
        <span>资料状态</span>
        <select data-knowledge-status>
          <option value="active">全部状态</option>
          <option value="verified">已确认</option>
          <option value="draft">待确认</option>
          <option value="trash">回收站</option>
        </select>
      </label>
    </div>
    <div class="seo-knowledge-note">
      <p>只有「已确认」且已启用的资料会用于生成候选主题；待确认资料可继续补充后再使用。</p>
      <span data-knowledge-count>正在加载</span>
    </div>
    <div
      class="product-table-scroll seo-table-scroll"
      tabindex="0"
      aria-label="知识资料表格，可横向滚动"
    >
      <table class="product-table seo-knowledge-table" aria-label="知识资料">
        <colgroup>
          <col class="seo-knowledge-title" />
          <col class="seo-knowledge-category" />
          <col class="seo-knowledge-status" />
          <col class="seo-task-date" />
          <col class="seo-knowledge-actions" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">资料名称</th>
            <th scope="col">关联分类</th>
            <th scope="col">状态</th>
            <th scope="col">更新时间</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody data-knowledge-rows>
          <tr>
            <td colspan="5" class="product-empty">
              正在加载知识资料…
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <dialog
    class="product-delete-dialog seo-dialog"
    data-knowledge-dialog
    aria-labelledby="knowledge-dialog-title"
  >
    <form data-knowledge-dialog-form>
      <h2 id="knowledge-dialog-title"></h2>
      <fieldset data-knowledge-dialog-fields></fieldset>
      <p class="product-error" data-knowledge-dialog-error role="alert" hidden></p>
      <div class="product-dialog-actions">
        <button type="button" data-knowledge-dialog-cancel>
          取消
        </button>
        <button type="submit" class="seo-dialog-submit" data-knowledge-dialog-save>
          保存资料
        </button>
      </div>
    </form>
  </dialog>
</main>
