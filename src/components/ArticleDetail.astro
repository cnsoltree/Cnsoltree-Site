---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import BlogCard from '@/components/BlogCard.astro';
import { type BlogPost } from '@/lib/data';
import { renderArticleContent, articleFaqs } from '@/lib/markdown';
import { blogCategoryHref, matchesBlogGroup } from '@/lib/blog-taxonomy';
import {
  getAllArticleGroups,
  getBlogPosts,
  href,
  langFromUrl,
  localizeLinks,
  locales,
  t,
} from '@/i18n';
interface Props {
  post: BlogPost;
  preview?: boolean;
}
const { post, preview = false } = Astro.props;
const lang = langFromUrl(Astro.url);
const site = 'https://www.elesoltree.com';
const rendered = await renderArticleContent(post.content);
const family = getAllArticleGroups(lang).find((group) => matchesBlogGroup(post, group));
const related = getBlogPosts(lang)
  .filter(
    (other) => other.slug !== post.slug && other.relatedCategorySlug === post.relatedCategorySlug,
  )
  .slice(0, 3);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    image: new URL(post.image, 'https://www.elesoltree.com').href,
    datePublished: post.date,
    dateModified: post.dateModified ?? post.date,
    author: { '@type': 'Person', name: post.author },
    publisher: { '@type': 'Organization', name: 'Soltree' },
    articleSection: family?.name,
  },
];
const faqs = articleFaqs(post.content);
const faqSchema = faqs.length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      },
    ]
  : [];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: t(lang, 'Home'), item: new URL(href(lang, '/'), `${site}/`).href },
    { name: t(lang, 'Blog'), item: new URL(href(lang, '/blog'), site).href },
    ...(family
      ? [
          {
            name: family.name,
            item: new URL(href(lang, blogCategoryHref(family.slug)), site).href,
          },
        ]
      : []),
    { name: post.title, item: new URL(href(lang, `/blog/${post.slug}`), site).href },
  ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })),
};
---

<BaseLayout
  noindex={preview}
  path={preview ? `/admin/article-preview/${post.slug}` : href(lang, `/blog/${post.slug}`)}
  title={post.metaTitle ?? post.title}
  description={post.metaDescription ?? post.excerpt}
  image={post.image}
  keywords={post.metaKeywords}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.dateModified ?? post.date}
  author={post.author}
  tags={post.tags}
  schema={[...schema, ...faqSchema, breadcrumb]}
>
  {preview && (
    <div class="border-b border-green-200 bg-green-50 px-6 py-3 text-center text-sm text-green-800">
      本地文章预览 · 此页面不会被搜索引擎收录
      <a href="/admin/articles" class="ml-5 font-semibold underline">
        返回文章管理
      </a>
    </div>
  )}
  <section class="border-b border-gray-100 bg-gray-50 py-12">
    <div class="container">
      <nav aria-label="Breadcrumb" class="mb-4 flex gap-2 text-xs text-gray-400">
        <a href={href(lang, '/')}>{t(lang, 'Home')}</a>
        <span>/</span>
        <a href={href(lang, '/blog')}>{t(lang, 'Blog')}</a>
        {family && (
          <>
            <span>/</span>
            <a href={href(lang, blogCategoryHref(family.slug))}>{family.name}</a>
          </>
        )}
      </nav>
      <div class="flex flex-wrap gap-2 text-xs font-semibold text-green-700">
        {family && (
          <a
            href={href(lang, blogCategoryHref(family.slug))}
            class="rounded-full bg-green-50 px-3 py-1.5 hover:bg-green-100"
          >
            {family.name}
          </a>
        )}
      </div>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-gray-900 sm:text-4xl">{post.title}</h1>
      <p class="mt-5 text-sm text-gray-500">
        {post.author} ·{' '}
        {post.date
          ? new Date(post.date).toLocaleDateString(lang === 'en' ? 'en-US' : locales[lang].hreflang, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })
          : '尚未设置发布日期'}{' '}
        · {t(lang, '{n} min read', { n: post.readingTime })}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px]">
      <article>
        {post.image ? (
          <Img
            src={post.image}
            alt={post.title}
            width={1000}
            priority
            class="mb-8 aspect-video w-full rounded-2xl object-cover"
          />
        ) : (
          <div class="mb-8 grid aspect-video place-items-center rounded-2xl bg-gray-50 text-sm text-gray-400">
            尚未上传文章封面
          </div>
        )}
        <div
          class="prose prose-sm max-w-none prose-headings:scroll-mt-24 prose-headings:text-gray-900 prose-a:text-green-700 prose-img:rounded-xl"
          set:html={localizeLinks(lang, rendered.code)}
        />
      </article>
      <aside>
        <nav
          aria-label={t(lang, 'Table of contents')}
          class="sticky top-24 rounded-xl border border-gray-100 p-5"
        >
          <h2 class="text-sm font-bold">{t(lang, 'On this page')}</h2>
          <ul class="mt-4 space-y-3">
            {rendered.metadata.headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="text-xs leading-relaxed text-gray-500 hover:text-green-700"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
          </ul>
          <a href={href(lang, '/contact')} class="btn-primary mt-6 w-full">
            {t(lang, 'Ask an Engineer')}
          </a>
        </nav>
      </aside>
    </div>
  </section>
  <section class="section-alt">
    <div class="container">
      <h2 class="section-heading">{t(lang, 'Related Articles')}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {related.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
