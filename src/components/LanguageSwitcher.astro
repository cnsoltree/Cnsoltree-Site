---
import { basePath, hasPage, href, langFromUrl, locales, t, type Lang } from '@/i18n';
const lang = langFromUrl(Astro.url);
const path = basePath(Astro.url);
// 目标语言没有当前页面时，跳到该语言首页
const options = (Object.keys(locales) as Lang[]).map((code) => ({
  code,
  label: locales[code].label,
  href: href(code, hasPage(code, path) ? path : '/'),
}));
---

<details class="relative" data-language-switcher>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50"
    aria-label={t(lang, 'Language')}
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" />
    </svg>
    {lang.toUpperCase()}
  </summary>
  <ul class="absolute end-0 top-full z-50 mt-1 min-w-36 rounded-lg border border-gray-100 bg-white py-1 shadow-lg">
    {options.map((option) => (
      <li>
        <a
          href={option.href}
          hreflang={locales[option.code].hreflang}
          lang={locales[option.code].hreflang}
          aria-current={option.code === lang ? 'true' : undefined}
          class:list={[
            'block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-700',
            option.code === lang ? 'font-semibold text-green-700' : 'text-gray-600',
          ]}
        >
          {option.label}
        </a>
      </li>
    ))}
  </ul>
</details>
<script>
  document.addEventListener('astro:page-load', () => {
    const switcher = document.querySelector<HTMLDetailsElement>('[data-language-switcher]');
    if (!switcher) return;
    const close = (event: PointerEvent) => {
      if (!switcher.contains(event.target as Node)) switcher.open = false;
    };
    document.addEventListener('pointerdown', close);
    document.addEventListener(
      'astro:before-swap',
      () => document.removeEventListener('pointerdown', close),
      { once: true },
    );
  });
</script>
