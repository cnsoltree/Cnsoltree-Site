---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductImageGallery from '@/components/ProductImageGallery.astro';
import { getProductsByCategory, type Product } from '@/lib/data';
import Img from '@/components/Img.astro';

interface Props {
  product: Product;
  preview?: boolean;
}
const { product, preview = false } = Astro.props;

const related = getProductsByCategory(product.categorySlug)
  .filter((p) => p.id !== product.id)
  .slice(0, 4);
const galleryImages = (
  product.images && product.images.length > 0 ? product.images : [product.image]
).filter(Boolean);
---

<BaseLayout
  noindex={preview}
  path={preview ? `/admin/product-preview/${product.id}` : `/products/${product.id}`}
  title={product.metaTitle ?? product.name}
  description={product.metaDescription ?? product.shortDescription}
  image={product.image}
  keywords={product.metaKeywords}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.shortDescription,
      image: new URL(product.image, 'https://www.elesoltree.com').href,
      sku: product.id,
      brand: { '@type': 'Brand', name: 'Soltree' },
    },
  ]}
>
  <>
    {preview && (
      <div class="border-b border-green-200 bg-green-50 px-6 py-3 text-center text-sm text-green-800">
        本地产品预览 · 此页面不会被搜索引擎收录
        <a href="/admin/products" class="ml-5 font-semibold underline">
          返回产品管理
        </a>
      </div>
    )}
    {/* Breadcrumb */}
    <div class="border-b border-gray-100 bg-gray-50 py-3">
      <div class="container">
        <nav class="flex items-center gap-2 text-xs text-gray-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gray-600">
            Home
          </a>
          <span>/</span>
          <a href="/products" class="hover:text-gray-600">
            Products
          </a>
          <span>/</span>
          {product.categorySlug ? (
            <a href={`/categories/${product.categorySlug}`} class="hover:text-gray-600">
              {product.categoryName}
            </a>
          ) : (
            <span>未选择分类</span>
          )}
          <span>/</span>
          <span class="max-w-[160px] truncate text-gray-600">{product.name}</span>
        </nav>
      </div>
    </div>

    {/* Product Main */}
    <section class="section">
      <div class="container">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
          {/* ── Image Gallery (client component) ─────────────────── */}
          {galleryImages.length ? (
            <ProductImageGallery
              images={galleryImages}
              productName={product.name}
              imageAlts={product.imageAlts}
            />
          ) : (
            <div class="grid aspect-square place-items-center rounded-2xl border border-dashed border-gray-200 bg-gray-50 text-sm text-gray-400">
              尚未上传产品图片
            </div>
          )}

          {/* ── Info ─────────────────────────────────────────────── */}
          <div>
            <p class="section-eyebrow">{product.categoryName}</p>
            <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">{product.name}</h1>

            {/* Description text */}
            <div class="mt-4 space-y-3 text-base leading-relaxed text-gray-600">
              {product.description.split('\n\n').map((para) => (
                <p>{para}</p>
              ))}
            </div>

            {/* Description images（接线图、应用场景图等） */}
            {product.descriptionImages && product.descriptionImages.length > 0 && (
              <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {product.descriptionImages.map((src, i) => (
                  <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-gray-100 bg-gray-50">
                    <Img
                      src={src}
                      alt={`${product.name} detail image ${i + 1}`}
                      fill
                      class="object-cover"
                      sizes="(max-width: 640px) 50vw, 200px"
                    />
                  </div>
                ))}
              </div>
            )}

            {/* Key Features */}
            <div class="mt-8">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-900">
                Key Features
              </h2>
              <ul class="mt-3 space-y-2">
                {product.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-600">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-green-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                      />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            {/* CTA */}
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary-lg flex-1 justify-center">
                Request Quotation
              </a>
              <a href="/contact" class="btn-outline-lg flex-1 justify-center">
                Ask Technical Question
              </a>
            </div>

            <p class="mt-4 text-xs text-gray-400">
              Samples available · OEM pricing on request · Ships worldwide
            </p>
          </div>
        </div>

        {/* Specifications Table */}
        <div class="mt-16">
          <h2 class="text-xl font-bold text-gray-900">Technical Specifications</h2>
          <div class="mt-4 overflow-hidden rounded-xl border border-gray-200">
            <table class="w-full text-sm">
              <tbody class="divide-y divide-gray-100">
                {Object.entries(product.specs).map(([key, value], idx) => (
                  <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                    <td class="w-1/3 px-5 py-3 font-medium text-gray-700">{key}</td>
                    <td class="px-5 py-3 text-gray-600">{value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    {/* Related Products */}
    {related.length > 0 && (
      <section class="section-alt">
        <div class="container">
          <h2 class="text-xl font-bold text-gray-900">More in {product.categoryName}</h2>
          <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )}
  </>
</BaseLayout>
