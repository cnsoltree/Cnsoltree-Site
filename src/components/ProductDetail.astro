---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductImageGallery from '@/components/ProductImageGallery.astro';
import CompanyIntro from '@/components/CompanyIntro.astro';
import { type Product } from '@/lib/data';
import Img from '@/components/Img.astro';
import { getProducts, getProductGroups, href, langFromUrl, t } from '@/i18n';
import { matchesSubcategory, subcategoryHref } from '@/lib/product-taxonomy';

interface Props {
  product: Product;
  preview?: boolean;
}
const { product, preview = false } = Astro.props;

const lang = langFromUrl(Astro.url);
const spdTopic =
  product.categorySlug === 'surge-protector-device'
    ? getProductGroups(lang)
        .flatMap((group) => group.items.map((item) => ({ group, item })))
        .find(({ item }) => matchesSubcategory(product, item))
    : undefined;
const categoryLabel = spdTopic ? spdTopic.item.name : product.categoryName;
const categoryLink = spdTopic
  ? subcategoryHref(spdTopic.item, spdTopic.group.slug)
  : `/categories/${product.categorySlug}`;
const detailSections = product.detailSections ?? [];
const displaySections = detailSections.some((section) => section.id === 'specifications')
  ? detailSections
  : [
      {
        id: 'main-specification',
        title: detailSections.length ? 'Main Specification' : t(lang, 'Technical Specifications'),
        content: '',
      },
      ...detailSections,
    ];
const related = getProducts(lang)
  .filter(
    (p) =>
      p.categorySlug === product.categorySlug ||
      p.additionalCategorySlugs?.includes(product.categorySlug),
  )
  .filter((p) => p.id !== product.id)
  .filter((p) => !spdTopic || matchesSubcategory(p, spdTopic.item))
  .slice(0, 4);
const baseImages = (
  product.images && product.images.length > 0 ? product.images : [product.image]
).filter(Boolean);
const colorVariants = product.colorVariants ?? [];
const galleryImages = [...new Set([...baseImages, ...colorVariants.map((color) => color.image)])];
const galleryAlts = galleryImages.map((src) => {
  const baseIndex = baseImages.indexOf(src);
  return (
    (baseIndex >= 0 ? product.imageAlts?.[baseIndex] : undefined) ||
    colorVariants.find((color) => color.image === src)?.alt ||
    product.name
  );
});
---

<BaseLayout
  noindex={preview}
  path={preview ? `/admin/product-preview/${product.id}` : href(lang, `/products/${product.id}`)}
  title={product.metaTitle ?? product.name}
  description={product.metaDescription ?? product.shortDescription}
  image={product.image}
  keywords={product.metaKeywords}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.shortDescription,
      image: new URL(product.image, 'https://www.elesoltree.com').href,
      sku: product.id,
      brand: { '@type': 'Brand', name: 'Soltree' },
    },
  ]}
>
  <>
    {preview && (
      <div class="border-b border-green-200 bg-green-50 px-6 py-3 text-center text-sm text-green-800">
        本地产品预览 · 此页面不会被搜索引擎收录
        <a href="/admin/products" class="ml-5 font-semibold underline">
          返回产品管理
        </a>
      </div>
    )}
    {/* Breadcrumb */}
    <div class="border-b border-gray-100 bg-gray-50 py-3">
      <div class="container">
        <nav class="flex items-center gap-2 text-xs text-gray-400" aria-label="Breadcrumb">
          <a href={href(lang, '/')} class="hover:text-gray-600">
            {t(lang, 'Home')}
          </a>
          <span>/</span>
          <a href={href(lang, '/products')} class="hover:text-gray-600">
            {t(lang, 'Products')}
          </a>
          <span>/</span>
          {product.categorySlug ? (
            <a href={href(lang, categoryLink)} class="hover:text-gray-600">
              {categoryLabel}
            </a>
          ) : (
            <span>未选择分类</span>
          )}
          <span>/</span>
          <span class="max-w-[160px] truncate text-gray-600">{product.name}</span>
        </nav>
      </div>
    </div>

    {/* Product Main */}
    <section class="section">
      <div class="container">
        <div data-product-main class="grid grid-cols-1 gap-10 lg:grid-cols-2">
          {/* ── Image Gallery (client component) ─────────────────── */}
          {galleryImages.length ? (
            <ProductImageGallery
              images={galleryImages}
              productName={product.name}
              imageAlts={galleryAlts}
            />
          ) : (
            <div class="grid aspect-square place-items-center rounded-2xl border border-dashed border-gray-200 bg-gray-50 text-sm text-gray-400">
              尚未上传产品图片
            </div>
          )}

          {/* ── Info ─────────────────────────────────────────────── */}
          <div>
            <p class="section-eyebrow">{categoryLabel}</p>
            <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">{product.name}</h1>

            {/* Description text */}
            <div class="mt-4 space-y-3 text-base leading-relaxed text-gray-600">
              {product.description.split('\n\n').map((para) => (
                <p>{para}</p>
              ))}
            </div>

            {/* Description images（接线图、应用场景图等） */}
            {product.descriptionImages && product.descriptionImages.length > 0 && (
              <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {product.descriptionImages.map((src, i) => (
                  <div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-gray-100 bg-gray-50">
                    <Img
                      src={src}
                      alt={t(lang, '{name} detail image {n}', { name: product.name, n: i + 1 })}
                      fill
                      class="object-cover"
                      sizes="(max-width: 640px) 50vw, 200px"
                    />
                  </div>
                ))}
              </div>
            )}

            {/* Key Features */}
            <div class="mt-8">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-900">
                {t(lang, 'Key Features')}
              </h2>
              <ul class="mt-3 space-y-2">
                {product.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-600">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-green-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.5 12.75l6 6 9-13.5"
                      />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>

            {Boolean(product.customizationOptions?.length || colorVariants.length) && (
              <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3">
                {Boolean(product.customizationOptions?.length) && (
                  <div class="flex flex-wrap gap-2">
                    {product.customizationOptions!.map((option) => (
                      <span class="rounded-full border border-green-200 bg-white px-2.5 py-1 text-xs font-medium text-green-800">
                        {option}
                      </span>
                    ))}
                  </div>
                )}
                {colorVariants.length > 0 && (
                  <fieldset class="mt-2">
                    <legend class="sr-only">Color</legend>
                    <div class="flex flex-wrap gap-2">
                      {colorVariants.map((color) => (
                        <button
                          type="button"
                          data-gallery-select={galleryImages.indexOf(color.image)}
                          data-color-name={color.name}
                          aria-label={`${lang === 'es' ? 'Ver color' : 'Show color'}: ${color.name}`}
                          aria-pressed={color.image === galleryImages[0] ? 'true' : 'false'}
                          class="h-12 w-12 rounded-md border-2 border-gray-200 bg-white p-1 transition hover:border-green-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700 aria-pressed:border-green-700 aria-pressed:bg-green-50"
                        >
                          <Img
                            src={color.image}
                            alt={color.alt || `${product.name} — ${color.name}`}
                            width={100}
                            class="h-full w-full object-contain"
                          />
                        </button>
                      ))}
                    </div>
                  </fieldset>
                )}
              </div>
            )}

            {/* CTA */}
            <div
              class:list={[
                'flex flex-col gap-3 sm:flex-row',
                product.customizationOptions?.length || colorVariants.length ? 'mt-5' : 'mt-8',
              ]}
            >
              <a href={href(lang, '/contact')} class="btn-primary-lg flex-1 justify-center">
                {t(lang, 'Request Quotation')}
              </a>
              <a href={href(lang, '/contact')} class="btn-outline-lg flex-1 justify-center">
                {t(lang, 'Ask Technical Question')}
              </a>
            </div>

            <p class="mt-4 text-xs text-gray-400">
              {t(lang, 'Samples available · OEM pricing on request · Ships worldwide')}
            </p>
          </div>
        </div>
      </div>
    </section>

    {detailSections.length > 0 && (
      <nav aria-label="Product detail sections" class="border-y border-gray-200 bg-gray-50">
        <div class="container flex flex-wrap gap-x-8 gap-y-3 py-5 text-sm font-semibold text-gray-600">
          {displaySections.map((section) => (
            <a class="hover:text-green-700" href={`#${section.id}`}>
              {section.title}
            </a>
          ))}
        </div>
      </nav>
    )}

    <div class="container grid gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_300px] xl:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0">
        {displaySections.map((section, index) => (
          <section
            id={section.id}
            class:list={[
              'scroll-mt-32',
              index > 0 && 'mt-12',
              section.id !== 'main-specification' && 'rounded-2xl p-6 sm:p-8',
              section.id !== 'main-specification' && index % 2 === 0 && 'bg-gray-50',
            ]}
            aria-labelledby={`${section.id}-heading`}
          >
            <div>
              <h2 id={`${section.id}-heading`} class="text-2xl font-bold text-gray-900 sm:text-3xl">
                {section.title}
              </h2>
              {section.content && (
                <div class="mt-6 max-w-4xl space-y-4 leading-relaxed text-gray-600">
                  {section.content.split('\n\n').map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              )}
              {section.image && (
                <div class="mt-6 bg-white">
                  <Img
                    src={section.image}
                    alt={section.imageAlt ?? section.title}
                    width={1318}
                    height={990}
                    class="mx-auto h-auto w-full"
                  />
                </div>
              )}
              {section.images?.map((image) => (
                <div class="mt-6 bg-white">
                  <Img src={image.src} alt={image.alt} width={1645} class="mx-auto h-auto w-full" />
                </div>
              ))}
              {section.table && (
                <div class="mt-4 overflow-hidden rounded-xl border border-gray-200">
                  <table class="w-full table-fixed text-sm">
                    <caption class="bg-gray-100 px-5 py-4 text-center font-semibold text-gray-900">
                      {section.table.caption}
                    </caption>
                    <tbody class="divide-y divide-gray-200">
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, index) => {
                            const value = typeof cell === 'string' ? { text: cell } : cell;
                            const isHeader = value.header ?? index === 0;
                            const is3PSpecLabel =
                              product.id === 'STD-40-PV-1000V' &&
                              section.id === 'specifications' &&
                              index === 0;
                            const Tag = isHeader ? 'th' : 'td';
                            return (
                              <Tag
                                rowspan={value.rowSpan}
                                colspan={value.colSpan}
                                scope={isHeader ? (value.rowSpan ? 'rowgroup' : 'row') : undefined}
                                class:list={[
                                  'break-words border-l border-gray-200 px-2 py-3 sm:px-4',
                                  is3PSpecLabel && 'w-[56%] whitespace-nowrap sm:w-[26%]',
                                  isHeader
                                    ? `bg-gray-50 font-medium text-gray-700 ${is3PSpecLabel ? 'text-center' : 'text-left'}`
                                    : 'text-center text-gray-600',
                                ]}
                              >
                                {value.text}
                              </Tag>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {!section.table && ['main-specification', 'specifications'].includes(section.id) && (
                <div class="mt-4 overflow-x-auto rounded-xl border border-gray-200">
                  <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                      {Object.entries(product.specs).map(([key, value], idx) => (
                        <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                          <th
                            scope="row"
                            class="w-1/3 px-5 py-3 text-left font-medium text-gray-700"
                          >
                            {key}
                          </th>
                          <td class="px-5 py-3 text-gray-600">{value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </section>
        ))}
      </div>
      <CompanyIntro lang={lang} />
    </div>

    {/* Related Products */}
    {related.length > 0 && (
      <section class="section-alt">
        <div class="container">
          <h2 class="text-xl font-bold text-gray-900">
            {t(lang, 'More in {category}', { category: categoryLabel })}
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )}
  </>
</BaseLayout>

<style>
  #installation-and-dimensions :global(th),
  #installation-and-dimensions :global(td) {
    padding: 0.4rem 0.6rem;
    border: 1px solid #d1d5db;
    background: transparent;
    vertical-align: middle;
    text-align: center;
    font-weight: 400;
  }
  #installation-and-dimensions :global(tr:nth-child(odd)) {
    background: #f3f4f6;
  }
  #installation-and-dimensions :global(tr:nth-child(-n + 2)) {
    background: white;
  }
</style>
