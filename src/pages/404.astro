---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <section class="section">
    <div class="container text-center">
      <p class="section-eyebrow">404</p>
      <h1 class="mt-4 text-4xl font-bold">Page Not Found</h1>
      <p class="mt-4 text-gray-500">The page you are looking for could not be found.</p>
      <a href="/products" class="btn-primary mt-8">
        Browse Products
      </a>
    </div>
  </section>
</BaseLayout>
