---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import ContactForm from '@/components/ContactForm.astro';
import { CONTACT, SITE } from '@/consts';

// Series and breaking capacities supplied for this landing page; pole variants are specified separately.
const dcSeries = [
  {
    name: 'DZ47Z-63',
    tier: 'Economy series',
    selectionText:
      'A budget-conscious option for circuits where the confirmed 4.5kA DC breaking capacity meets the required fault level.',
    capacity: '4.5kA',
    internalImage: '/images/uploads/dz47z-63-4-5ka-internal.png',
    internalAlt:
      'DZ47Z-63 4.5kA DC MCB internal view showing the central coil, upper contact mechanism and lower arc chute',
    internalText:
      'A central coil sits below the upper contact mechanism, with the arc chute arranged beneath the coil.',
  },
  {
    name: 'STZ-63',
    tier: 'Standard series',
    selectionText:
      'The standard option for circuits requiring 6kA DC breaking capacity, subject to the selected voltage and wiring arrangement.',
    capacity: '6kA',
    internalImage: '/images/uploads/stz-63-6ka-internal.png',
    internalAlt:
      'STZ-63 6kA DC MCB internal view showing the upper-left coil, lower-left arc chute and right-side contact mechanism',
    internalText:
      'The coil and arc chute are arranged on the left, with the contact mechanism and spring assembly on the right.',
  },
];
const faqGroups = [
  {
    title: 'Ratings & model selection',
    items: [
      [
        'What is a DC miniature circuit breaker (DC MCB)?',
        'A DC miniature circuit breaker provides overload and short-circuit protection in a direct-current circuit within its specified ratings. Select a model using the circuit voltage, load current, prospective fault current and permitted wiring arrangement. A DC rating must be stated in the documentation for the exact model.',
      ],
      [
        'What is the difference between DZ47Z-63 and STZ-63 DC MCBs?',
        'The Soltree range presented here lists DZ47Z-63 at 4.5kA and STZ-63 at 6kA breaking capacity. These are two series options, not current ratings. Confirm the breaking capacity at your required DC voltage, together with the current rating, poles and wiring diagram, for the exact model quoted.',
      ],
      [
        'How do I choose between 4.5kA and 6kA breaking capacity?',
        'Choose a DC breaking capacity that covers the prospective short-circuit current at the installation point, at the applicable DC voltage and specified conditions. A higher kA value does not mean the breaker carries more load current. Confirm the fault level and model documentation before choosing DZ47Z-63 or STZ-63.',
      ],
      [
        'How do I select the rated current of a DC MCB?',
        'Select the DC MCB current rating to suit the circuit load and conductor protection requirements. Review cable capacity, installation temperature, derating and the load characteristics with the circuit designer. Rated current in amperes (A) and breaking capacity in kiloamperes (kA) describe different requirements; both need to be checked.',
      ],
      [
        'What is the difference between 1P, 2P, 3P and 4P DC MCBs?',
        'The pole count identifies the number of breaker poles; it does not by itself establish a usable DC voltage. The required pole arrangement depends on the system voltage, earthing and the manufacturer-approved wiring. Do not assume that adding poles automatically increases the voltage rating or that any series connection is permitted.',
      ],
    ],
  },
  {
    title: 'Applications, wiring & ordering',
    items: [
      [
        'Can an AC MCB be used in a DC circuit?',
        'An AC-only MCB must not be selected for a DC circuit based on its AC rating. Use a breaker with an explicit DC rating suitable for the circuit. A dual-rated model may have different AC and DC voltage limits and wiring requirements, so check its DC documentation and polarity markings.',
      ],
      [
        'How do I choose a DC MCB for a solar PV string?',
        'Select PV circuit protection using the maximum string open-circuit voltage under the design conditions, circuit current and fault conditions. Confirm that the exact breaker is suitable for the intended PV circuit and wiring arrangement. Send the string layout, inverter model and wiring diagram for review; the series name alone does not establish suitability.',
      ],
      [
        'Can a DC MCB be used in a battery storage system?',
        'A DC MCB can be considered for a battery circuit only when its voltage rating, fault interruption capability and wiring conditions match that system. Battery fault current can differ substantially from PV fault current. Provide battery data, the protection arrangement and any charging or reverse-current conditions for model-specific review.',
      ],
      [
        'Is a DC MCB the same as a DC isolator?',
        'A DC MCB provides overcurrent protection, while a DC switch-disconnector provides switching and isolation. A particular breaker may also be suitable for isolation if that function is confirmed by its markings and documentation. Do not replace a specified isolator with an MCB solely because both devices can open a circuit.',
      ],
      [
        'What should I send for a Soltree DC MCB or OEM quotation?',
        'Send the application, maximum DC voltage, rated current, poles, required breaking capacity and wiring diagram. Add the preferred series (DZ47Z-63 or STZ-63), quantity, destination market and documentation requirements. For OEM enquiries, include logo, label and packaging needs. Available configurations, samples and delivery timing are confirmed with the quotation.',
      ],
    ],
  },
];
const faqs = faqGroups.flatMap((group) => group.items);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'DC MCB', item: `${SITE.url}/dc-mcb` },
    ],
  },
];
---

<BaseLayout
  title="DZ47Z-63 & STZ-63 DC MCB | 4.5kA & 6kA | Soltree"
  description="Compare DZ47Z-63 4.5kA and STZ-63 6kA DC miniature circuit breakers. Specify your DC voltage, current and poles for a Soltree OEM quotation."
  path="/dc-mcb"
  image="/images/products/MCB-DC-2P-01.jpg"
  schema={schema}
>
  <section class="dc-mcb-hero overflow-hidden bg-[#102c24] text-white">
    <div class="container py-12 sm:py-20">
      <nav aria-label="Breadcrumb" class="mb-10 text-sm text-green-200">
        <a href="/" class="hover:text-white">
          Home
        </a>
        <span aria-hidden="true" class="mx-3">
          /
        </span>
        <span>DC MCB</span>
      </nav>
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-300">
            Solar PV & DC protection
          </p>
          <h1 class="mt-4 text-[2.125rem] font-bold leading-[1.12] tracking-tight sm:text-5xl">
            DC Miniature <span class="block text-green-300">Circuit Breakers</span>
          </h1>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-gray-200">
            Two series for PV and DC distribution projects. Share your voltage, current and pole
            requirements for a tailored quotation.
          </p>
          <div class="mt-7 max-w-lg border-y border-white/15 py-4">
            <p class="text-xs text-gray-300">Series / breaking capacity</p>
            <dl class="mt-3 grid grid-cols-2 divide-x divide-white/15">
              {dcSeries.map((series, index) => (
                <div class:list={[index > 0 && 'pl-4']}>
                  <dt class="text-sm font-semibold">{series.name}</dt>
                  <dd class="mt-1 text-lg font-semibold text-green-300">{series.capacity}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="#inquiry" class="btn-primary">
              Request a quote <span aria-hidden="true">→</span>
            </a>
            <a
              href="#choose-series"
              class="rounded-sm py-2 text-sm font-semibold text-green-200 underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-300"
            >
              Compare series <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="rounded-2xl bg-[#f5f7f4] p-6 text-gray-900 shadow-2xl sm:p-8">
          <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-widest text-gray-500">
            <span>STZ-63 series</span>
            <span>6kA</span>
          </div>
          <div class="mt-6 overflow-hidden rounded-xl">
            <Img
              src="/images/uploads/stz-63-series-overview.png"
              alt="Soltree STZ-63 series 6kA DC miniature circuit breaker range in multiple colour options"
              width={1536}
              height={1024}
              priority
              class="h-auto w-full object-contain"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
          </div>
          <p class="mt-6 border-t border-gray-200 pt-5 text-sm leading-relaxed text-gray-500">
            Need an AC distribution breaker instead?{' '}
            <a href="/ac-mcb" class="font-semibold text-green-700 underline underline-offset-4">
              View AC MCBs
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="DC MCB page sections" class="border-b border-gray-200 bg-gray-50">
    <div class="container flex flex-wrap gap-x-8 gap-y-3 py-5 text-sm font-semibold text-gray-600">
      <a href="#choose-series">Choose your series</a>
      <a href="#overview">DC protection</a>
      <a href="#series">Series comparison</a>
      <a href="#selection">Selection checklist</a>
      <a href="#applications">Applications</a>
      <a href="#oem">OEM</a>
      <a href="#faq">FAQs</a>
    </div>
  </nav>

  <section
    id="choose-series"
    class="border-b border-green-900/10 bg-[#f1f5f1] py-8 text-gray-900 sm:py-10"
    aria-labelledby="choose-series-heading"
  >
    <div class="container">
      <div class="grid gap-3 lg:grid-cols-2 lg:items-center lg:gap-12">
        <h2
          id="choose-series-heading"
          class="max-w-xl text-2xl font-bold leading-tight tracking-tight sm:text-3xl"
        >
          Which DC MCB series should you choose?
        </h2>
        <p class="max-w-xl text-sm leading-relaxed text-gray-600 sm:text-base">
          Compare 4.5kA and 6kA options, then match the DC voltage, trip curve and wiring to your
          circuit.
        </p>
      </div>
      <div class="mt-6 grid border-t border-green-900/15 md:grid-cols-2">
        {[
          {
            tier: 'Economy',
            model: 'DZ47Z-63',
            capacity: '4.5kA',
            positioning: 'Lower price · Budget-friendly',
            href: '#inquiry',
            text: 'Economy model for B/C/D-curve DC distribution applications, with 4.5kA breaking capacity. A cost-conscious choice where its rated capacity meets the circuit requirements.',
          },
          {
            tier: 'Standard',
            model: 'STZ-63',
            capacity: '6kA',
            positioning: 'Higher specification · 6kA',
            href: '/products/STZ-63-DC',
            text: 'Standard 6kA model with B/C/D trip-curve options for DC distribution. Choose it where the circuit requires 6kA breaking capacity, with the curve matched to the load.',
          },
        ].map(({ tier, model, capacity, positioning, href, text }, index) => (
          <div
            class:list={[
              'flex flex-col pt-5 pb-2',
              index === 0
                ? 'pb-5 md:pb-2 md:pr-10'
                : 'border-t border-green-900/15 md:border-l md:border-t-0 md:pl-10',
            ]}
          >
            <div class="flex items-center gap-3">
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-green-800">{tier}</p>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-green-900 ring-1 ring-green-900/10">
                {capacity}
              </span>
            </div>
            <h3 class="mt-2 text-xl font-bold sm:text-2xl">Choose {model}</h3>
            <p class="mt-3 max-w-xl flex-1 text-sm leading-relaxed text-gray-600">{text}</p>
            <p class="mt-3 text-sm font-semibold text-gray-900">{positioning}</p>
            <a
              href={href}
              aria-label={`${index === 1 ? 'View' : 'Enquire about'} ${model} DC MCB`}
              class="mt-2 self-start rounded-sm py-2 text-sm font-semibold text-green-800 underline-offset-4 hover:text-green-950 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-700"
            >
              {index === 1 ? 'View' : 'Enquire about'} {model} <span aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="overview" class="container py-16 sm:py-20" aria-labelledby="overview-heading">
    <p class="section-eyebrow">Understand the circuit</p>
    <h2 id="overview-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
      DC protection starts with the actual system.
    </h2>
    <p class="mt-5 leading-relaxed text-gray-600">
      A miniature circuit breaker provides overload and short-circuit protection within its
      specified operating limits. For a DC project, the selected device must be rated for the system
      voltage and fault conditions, with the pole arrangement and connections confirmed against its
      wiring diagram. Similar appearance does not make AC and DC ratings interchangeable.
    </p>
    <div class="mt-6 grid overflow-hidden rounded-xl border border-gray-200 md:grid-cols-3">
      {[
        [
          'Circuit voltage',
          'Use the maximum voltage under the design conditions, not just a nominal system label.',
        ],
        [
          'Fault interruption',
          'Check the breaking rating at the applicable DC voltage against the prospective fault current.',
        ],
        [
          'Wiring arrangement',
          'Confirm polarity, earthing, protected poles and any permitted series connections from the model documentation.',
        ],
      ].map(([title, text], index) => (
        <div
          class:list={[
            'p-6 sm:p-8',
            index === 1 && 'border-y border-gray-200 bg-[#edf3ee] md:border-x md:border-y-0',
          ]}
        >
          <h3 class="font-semibold">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="series" class="bg-gray-50 py-16 sm:py-24" aria-labelledby="series-heading">
    <div class="container">
      <p class="section-eyebrow">Construction & ratings</p>
      <h2 id="series-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
        DZ47Z-63 vs STZ-63: compare DC MCB series
      </h2>
      <p class="mt-5 leading-relaxed text-gray-600">
        Compare the economy 4.5kA and standard 6kA series, from internal construction to circuit
        requirements. Use the model name and breaking capacity as your enquiry reference.
      </p>
      <div class="mt-8 grid gap-6">
        {dcSeries.map((series) => (
          <article class="grid overflow-hidden rounded-xl border border-gray-200 bg-white md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
            <figure class="p-5 sm:p-6">
              <Img
                src={series.internalImage}
                alt={series.internalAlt}
                width={800}
                height={800}
                class="mx-auto aspect-square w-full max-w-[400px] object-contain"
                sizes="(min-width: 768px) 400px, 100vw"
              />
              <figcaption class="mt-3 text-center text-xs text-gray-500">
                {series.name} internal construction
              </figcaption>
            </figure>
            <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
              <p class="text-xs font-semibold uppercase tracking-wider text-green-700">
                {series.tier}
              </p>
              <h3 class="mt-3 text-2xl font-bold sm:text-3xl">{series.name} DC MCB</h3>
              <div class="mt-5">
                <p class="text-3xl font-bold text-green-800">{series.capacity}</p>
                <p class="mt-1 text-sm text-gray-500">Breaking capacity</p>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-gray-600">{series.selectionText}</p>
              <div class="mt-5 border-l-2 border-green-600 pl-4">
                <h4 class="text-sm font-semibold">Internal layout</h4>
                <p class="mt-2 text-sm leading-relaxed text-gray-600">{series.internalText}</p>
              </div>
              <a
                href="#inquiry"
                class="mt-6 border-t border-gray-100 pt-5 text-sm font-semibold text-green-700 underline underline-offset-4"
              >
                Enquire about {series.name} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-5 text-sm leading-relaxed text-gray-500">
        Internal views are for construction comparison. Confirm the breaking capacity at your
        required DC voltage and the wiring arrangement in the documentation for the selected model.
      </p>
      <div id="selection" class="mt-12" aria-labelledby="selection-heading">
        <h3 id="selection-heading" class="text-2xl font-bold sm:text-3xl">
          Three checks before selecting a model
        </h3>
        <ol class="mt-6 divide-y divide-gray-200 border-y border-gray-200">
          {[
            [
              'Confirm the DC circuit',
              'Identify the application, maximum operating voltage and earthing arrangement. For PV, include the maximum string open-circuit voltage under the site design conditions.',
            ],
            [
              'Match current and fault level',
              'Review circuit current, conductor capacity and prospective short-circuit current. Check the selected breaking rating at the actual DC voltage; a current rating alone is not enough.',
            ],
            [
              'Check poles, polarity and isolation',
              'Use the model wiring diagram to confirm connections and any polarity restrictions. If isolation is required, confirm that function explicitly in the device documentation.',
            ],
          ].map(([title, text], index) => (
            <li class="grid gap-4 py-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12">
              <div class="lg:self-center">
                <p class="text-xs font-bold text-green-700">STEP {index + 1}</p>
                <h4 class="mt-3 text-lg font-semibold">{title}</h4>
              </div>
              <p class="text-sm leading-relaxed text-gray-600 lg:self-center">{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section
    id="applications"
    class="bg-[#edf3ee] py-16 sm:py-24"
    aria-labelledby="applications-heading"
  >
    <div class="container">
      <p class="section-eyebrow">Application planning</p>
      <h2 id="applications-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
        Plan around the DC side of your project.
      </h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {[
          [
            'Solar PV circuits',
            'Review compatible DC protection for combiner and inverter-side circuits. Share the string layout, inverter data and required protection arrangement.',
          ],
          [
            'DC distribution & equipment',
            'Compare the listed models for compatible DC supplies and equipment circuits. Confirm the operating voltage, load and expected fault level.',
          ],
          [
            'Battery project review',
            'Battery systems can present demanding fault conditions. Provide battery and protection-system data so suitability can be assessed for the exact circuit.',
          ],
        ].map(([title, text]) => (
          <article class="rounded-xl border border-green-900/10 bg-white p-6 sm:p-8">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{text}</p>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-4 rounded-xl border border-green-900/10 p-6 text-sm font-semibold text-green-800">
        <a href="/dc-surge-protector">
          Explore DC surge protection <span aria-hidden="true">→</span>
        </a>
        <a href="/categories/pv-combiner-box">
          Browse PV combiner boxes <span aria-hidden="true">→</span>
        </a>
        <a href="/ac-mcb">
          Need AC MCBs? <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="oem" class="container py-16 sm:py-20" aria-labelledby="oem-heading">
    <p class="section-eyebrow">For distributors & system builders</p>
    <h2 id="oem-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
      Build your DC MCB supply brief.
    </h2>
    <p class="mt-5 leading-relaxed text-gray-600">
      Discuss the product configuration and brand presentation together. Include your target
      ratings, models and quantities so available OEM options, documentation and order terms can be
      confirmed.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {[
        [
          'Electrical specification',
          'Provide the DZ47Z-63 or STZ-63 series, required breaking capacity, DC voltage, current and poles, together with the circuit diagram.',
        ],
        [
          'Branding & packaging',
          'Share the logo, label information, packaging artwork and destination market for your product range.',
        ],
        [
          'Order requirements',
          'Confirm quantities and requested documentation, samples and delivery timing with your quotation.',
        ],
      ].map(([title, text]) => (
        <div class="border-l-2 border-green-600 pl-5">
          <h3 class="font-semibold">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{text}</p>
        </div>
      ))}
    </div>
    <a href="#inquiry" class="btn-primary mt-8">
      Discuss DC MCB pricing <span aria-hidden="true">→</span>
    </a>
  </section>

  <section id="faq" class="bg-gray-50 py-16 sm:py-24" aria-labelledby="faq-heading">
    <div class="container">
      <p class="section-eyebrow">Before you specify</p>
      <h2 id="faq-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
        DC MCB FAQs: ratings, selection & applications
      </h2>
      <p class="mt-5 leading-relaxed text-gray-600">
        Compare DZ47Z-63 and STZ-63, understand DC breaker ratings, and prepare the details for your
        PV, battery or OEM enquiry.
      </p>
      <div class="mt-8 grid items-start gap-6 lg:grid-cols-2">
        {faqGroups.map((group) => (
          <div class="rounded-xl border border-gray-200 bg-white px-6 sm:px-8">
            <h3 class="border-b border-gray-200 py-5 font-semibold text-green-800">
              {group.title}
            </h3>
            <div class="divide-y divide-gray-200">
              {group.items.map(([question, answer]) => (
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-sm font-semibold leading-relaxed group-open:text-green-800 focus-visible:outline-2 focus-visible:outline-green-700">
                    <span>{question}</span>
                    <span aria-hidden="true" class="shrink-0 text-lg text-green-700">
                      <span class="group-open:hidden">+</span>
                      <span class="hidden group-open:inline">−</span>
                    </span>
                  </summary>
                  <p class="pb-6 text-sm leading-relaxed text-gray-600">{answer}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 flex flex-col gap-5 rounded-xl bg-[#edf3ee] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div>
          <h3 class="font-semibold">Need help choosing a DC MCB?</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Send your DC voltage, current, wiring diagram and quantity with your enquiry.
          </p>
        </div>
        <a href="#inquiry" class="btn-primary shrink-0 self-start sm:self-auto">
          Ask about your project <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="inquiry" class="bg-[#102c24] py-16 sm:py-24">
    <div class="container grid gap-10 lg:grid-cols-2 lg:gap-20">
      <div class="min-w-0 self-center text-white">
        <p class="text-sm font-semibold uppercase tracking-widest text-green-300">
          Get a DC MCB quote
        </p>
        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Tell us about your DC circuit.</h2>
        <p class="mt-6 leading-relaxed text-green-100">
          Send your requirements or bill of materials. If the model is still undecided, include the
          available circuit information so the configuration can be reviewed.
        </p>
        <ul class="mt-8 space-y-4 text-sm text-gray-200">
          <li>01 — Application, maximum DC voltage and wiring diagram</li>
          <li>02 — DZ47Z-63 4.5kA / STZ-63 6kA, current and poles</li>
          <li>03 — Quantities, destination and requested documentation</li>
          <li>04 — Logo, label, packaging or sample requirements</li>
        </ul>
        <ul class="mt-8 space-y-4 border-t border-white/15 pt-8 text-sm text-gray-200">
          {[
            [
              `mailto:${CONTACT.email}`,
