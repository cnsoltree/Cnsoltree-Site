  [
    'PV combiner box industry',
    'Leading Manufacturer',
    'M12 21V10 M12 15C4 15 2 8 3 3c6 0 10 4 9 12z M12 18c0-8 4-12 9-12 1 7-3 12-9 12z',
  ],
  [
    'Global partners',
    '3,000+',
    'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z M3 12h18 M12 3c4 5 4 13 0 18-4-5-4-13 0-18z',
  ],
  [
    'Core R&D team',
    '30+ Specialists',
    'M9 3h6 M10 3v6l-6 10a1 1 0 0 0 1 2h14a1 1 0 0 0 1-2L14 9V3 M7 15h10',
  ],
  [
    'Employees',
    '100+',
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0z M17 4a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-4',
  ],
  [
    '2025 production value',
    'CNY 80M+',
    'M3 21h18 M6 17v-4 M10 17V9 M14 17V5 M18 17V3 M3 10l6-5 4 1 7-5',
  ],
  ['Factory floor area', '10,000+ m²', 'M3 10l9-7 9 7 M5 9v12h14V9 M9 21v-8h6v8'],
];

const customization = [
  [
    'M4 4h6v6H4z M14 14h6v6h-6z M7 10v7h7 M14 7h6 M17 4v6',
    'Circuit configuration',
    'String inputs, outputs and inverter connections matched to your diagram, with independent MPPT circuits kept separate where required.',
  ],
  [
    'M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3z M13 7l-4 6h5l-3 5',
    'Protection & switching',
    'DC breakers or isolators, PV fuses and surge protection, with ratings and coordination reviewed for your circuit.',
  ],
  [
    'M5 3h14v18H5z M8 6h8v12H8z M13 12h.01',
    'Enclosure & layout',
    'Steel or plastic housing, cable entries and internal layout planned around your installation and maintenance access.',
  ],
  [
    'M7 3v4 M11 3v4 M5 7h8v3a4 4 0 0 1-8 0V7z M9 14v3a4 4 0 0 0 8 0v-3 M15 10h4v4h-4z',
    'Wiring & connections',
    'Cable sizes, connectors, polarity markings and internal routing specified for the approved configuration.',
  ],
  [
    'M20 13l-7 7-10-10V3h7l10 10z M7 7h.01',
    'OEM identification',
    'Your logo, nameplate, circuit labels and packaging for a consistent brand presentation.',
  ],
  [
    'M14 3H5v18h14V8l-5-5z M14 3v5h5 M8 12h8 M8 16h6',
    'Project documentation',
    'Drawings, component lists and inspection records, with market-specific document requirements reviewed for your project.',
  ],
];
const projects = [
  [
    'Commercial & industrial rooftops',
    'Plan configurations around roof zones, inverter connections and maintenance access, with clear circuit identification across the installation.',
    'M3 11l9-7 9 7 M5 10v10h14V10 M8 20v-6h8v6 M8 8h8',
  ],
  [
    'Ground-mount solar projects',
    'Discuss enclosure requirements, cable entries and supply batches around the site environment and project delivery schedule.',
    'M5 4h14l3 12H2L5 4z M4 10h16 M9 4l-1 12 M15 4l1 12 M9 16v4 M15 16v4 M6 20h12',
  ],
  [
    'OEM & distribution partners',
    'Agree a repeat-order configuration with consistent components, brand identification and packaging requirements for your market.',
    'M3 7l9-4 9 4-9 4-9-4z M3 7v10l9 4 9-4V7 M12 11v10 M7.5 5l9 4',
  ],
];
const workflow = [
  [
    'Project brief',
    'Share your drawing, inverter details, quantity and destination. Flag any requirements still to be decided.',
  ],
  [
    'Configuration review',
    'Review the circuit, protection components, enclosure layout and required documents together.',
  ],
  [
    'Specification approval',
    'Approve drawings and the component list before production. Confirm whether a sample or first article is needed.',
  ],
  [
    'Production & delivery',
    'Coordinate inspection, labeling, packing and shipment batches against the agreed delivery plan.',
  ],
];
// Show “Read the full project” only once the case page exists, so visitors never hit a 404.
const casePages = Object.keys(import.meta.glob('/src/pages/projects/*.astro')).map((file) =>
  file.replace('/src/pages', '').replace(/.astro$/, ''),
);
const references = [
  {
    id: 'HT-8Way-2in1out-600VDC',
    caseHref: '/projects/plastic-combiner-box-residential-rooftop',
    image: '/images/uploads/ht-8way-rooftop-installed.png',
    imageAlt: 'HT 8-way plastic PV combiner box wall-mounted beside a rooftop solar array',
    title: '2-in / 1-out Plastic Combiner Box',
    enclosure: 'Plastic enclosure',
    customer: 'Solar installer / South Africa / Rooftop PV',
    application:
      'Two rooftop strings combined into one inverter input, supplied as a pre-wired box the installer reorders under one part number.',
    specs: [
      ['Inputs / outputs', '2 in / 1 out'],
      ['Max system voltage', '600V DC'],
      ['DC breaker', '63A'],
      ['PV fuses', '4 × 15A'],
      ['Surge protection', '500V DC · 40kA'],
      ['Enclosure', 'Flame-retardant plastic · IP65'],
    ],
    why: 'A compact, lightweight housing for wall mounting on residential roofs, with the same layout on every repeat order.',
  },
  {
    id: 'PCB-M6in-05',
    caseHref: '/projects/steel-combiner-box-multi-string-pv',
    image: '/images/uploads/steel-combiner-box-carport-installed.png',
    imageAlt: 'Steel PV combiner box mounted on a solar carport column with cable tray',
    title: '6-input Steel Combiner Box',
    enclosure: 'Steel enclosure',
    customer: 'Engineering procurement / Multi-string PV',
    application:
      'Six PV strings combined into one 125A output for a larger array, with internal space for organized wiring and maintenance.',
    specs: [
      ['Inputs / outputs', '6 in / 1 out'],
      ['DC breaker', '125A'],
      ['PV fuses', '6 × 15A'],
      ['Surge protection', '500V DC · 40kA'],
      ['Enclosure', 'Steel · IP65'],
      ['Security', 'Safety lock & key'],
    ],
    why: 'A steel, lockable enclosure for sites where the box is exposed to impact or unauthorized access.',
  },
].map((item) => ({ ...item, product: getProductById(item.id)! }));
const faqGroups = [
  {
    title: 'System selection & protection',
    items: [
      [
        'What does a PV combiner box do?',
        'A PV combiner box brings string circuits into an organized enclosure for connection and protection. Depending on the design, it combines strings into a shared output or keeps circuits separate for independent inverter inputs. It does not convert DC power to AC.',
      ],
      [
        'Does every solar installation need an external combiner box?',
        'The inverter connection plan determines whether an external box is needed. Review its available string inputs and built-in protection against the array layout and project requirements. Send the inverter data sheet and string plan rather than selecting a box by system power alone.',
      ],
      [
        'How do I choose a PV combiner box for my inverter?',
        'Start with the inverter model and wiring diagram. Confirm string inputs, outputs, design voltage and current, then review protection and enclosure requirements. Our configuration examples are references; the final selection follows your approved project specification.',
      ],
      [
        'Which protection components are included?',
        'The component list is configuration-specific. Our project examples include PV fuses, a DC breaker and surge protection. Switching devices, cable sizes and connections are reviewed together before approval.',
      ],
      [
        'Can one box serve multiple inverter MPPT inputs?',
        'Yes, with a layout that preserves the independent circuits required by the inverter. Multiple outputs do not necessarily share one combined bus. Send the inverter model and wiring diagram so we can review each circuit and combining point.',
      ],
      [
        'What does 2-in / 1-out or 2-in / 2-out mean?',
        'These labels describe input and output counts. A 2-in / 1-out design typically combines two strings, while a 2-in / 2-out design can preserve two separate circuits. Always check the wiring diagram: the label alone does not confirm internal connections or MPPT compatibility.',
      ],
      [
        'How should I specify system voltage and current?',
        'Provide module Voc and Isc, modules per string, parallel string count and the site minimum temperature. The design review must account for cold-weather string voltage, inverter limits, cable ratings and protection coordination. A power rating in kW alone is insufficient.',
      ],
      [
        'Can I use a PV combiner box for AC circuits or batteries?',
        'Only use a box approved for the intended circuit. Our featured examples are PV DC configurations. AC aggregation and battery protection require separate reviews of device ratings, fault current, switching and wiring; a matching voltage label alone does not establish suitability.',
      ],
    ],
  },
  {
    title: 'Enclosures, installation & maintenance',
    items: [
      [
        'Are your PV combiner boxes suitable for outdoor installation?',
        'Our featured plastic and steel boxes specify IP65. Confirm the selected model, seals, cable entries and site conditions before installation; an IP65 rating does not permit submersion.',
      ],
      [
        'Should I choose a plastic or steel enclosure?',
        'Our plastic project example prioritizes light weight and compact wall mounting. The steel example adds a lockable housing for exposed sites. Choose around installation space, access and environmental requirements.',
      ],
      [
        'Can the box be installed in coastal, hot or cold environments?',
        'Share the site temperature range, sun exposure, humidity and salt or chemical exposure. Enclosure material, seals, component operating limits and thermal performance must be reviewed for that location. The featured IP65 rating alone does not confirm UV, corrosion or temperature suitability.',
      ],
      [
        'Are the boxes supplied pre-wired?',
        'Our two featured customer configurations are pre-wired assemblies. Confirm the supplied components, external terminations, cable entries and installation documents in your order specification. Pre-wiring still requires on-site mounting, connection and commissioning.',
      ],
      [
        'Who should install and commission the combiner box?',
        'Use a qualified PV installer or electrician following the supplied instructions and local requirements. Commissioning includes checks of polarity, connections, protective earthing and the approved circuit arrangement. PV conductors can remain live in daylight after the inverter is switched off.',
      ],
      [
        'What routine maintenance is required?',
        'Follow the selected assembly instructions for inspection intervals. Check for water ingress, damaged seals, loose or overheated connections and protection-device status. Internal work requires qualified personnel, isolation of all relevant sources and verification of a safe working condition; never open fuse holders under load.',
      ],
      [
        'How do I select replacement fuses or SPD modules?',
        'Use the approved component list and device instructions. Match the fuse type and electrical ratings, or the SPD module and compatible base. Send the box identification and component label for review before substituting a part.',
      ],
    ],
  },
  {
    title: 'Customization, OEM & documentation',
    items: [
      [
        'Can you customize a PV combiner box to our drawing?',
        'Yes. Soltree reviews circuit inputs and outputs, protection components, enclosure layout, cable entries and wiring against your drawing. OEM options include your logo, nameplate, circuit labels and packaging. The quotation and approved specification define the final scope.',
      ],
      [
        'Can cable entries and connectors match our installation?',
        'Yes, cable entry positions, cable sizes, connectors and internal routing can be specified during layout review. Include your cable and mating-connector details so mechanical fit, electrical compatibility, sealing and installation access can be checked together.',
      ],
      [
        'Can I request monitoring or additional protection functions?',
        'Include a separate schedule for functions such as string monitoring, remote alarms or reverse-current protection. Specify the measurements, interface and operating requirements. These are project requirements to review, rather than standard features of every configuration shown here.',
      ],
      [
        'Which certificates and inspection documents can you provide?',
        'Send the standards, certificates and inspection records required by your project or market. We will confirm which documents apply to the proposed assembly and components. Component certificates do not automatically certify the complete box.',
      ],
      [
        'What is confirmed before production starts?',
        'The agreed scope should identify the wiring diagram, component list, enclosure layout, electrical ratings, labels, packaging and required documents. Confirm any sample approval criteria and inspection requirements before releasing the order for production.',
      ],
      [
        'Can you support consistent configurations for repeat orders?',
        'Yes. Agree a repeat-order configuration with defined components, layout, identification and packaging. Reference the previous order and approved drawing revision, and confirm any proposed changes before production so different batches remain aligned with your project requirements.',
      ],
    ],
  },
  {
    title: 'Quotations, delivery & after-sales',
    items: [
      [
        'What are the MOQ and lead time for custom orders?',
        'MOQ and production lead time are quoted for the agreed configuration, quantity and sample requirements. Include your destination and target arrival date so production and transit can be planned separately.',
      ],
      [
        'Do you offer samples before a project order?',
        'Request a sample or first article with your enquiry. Its specification, cost and schedule will be confirmed before proceeding; agree any approval criteria before production.',
      ],
      [
        'What should I send for an EPC quotation or tender enquiry?',
        `Email your single-line diagram, inverter model, electrical requirements and bill of quantities to ${CONTACT.email}. Include enclosure requirements, mandatory documents, destination and delivery milestones. You can also start with the enquiry form below and send drawings by email.`,
      ],
      [
        'How are packing and shipping arranged?',
        'Packing, shipment batches, destination and delivery responsibilities are agreed with the order. Include handling or labeling requirements in your enquiry.',
      ],
      [
        'What warranty and after-sales terms apply?',
        'Confirm the warranty period, coverage and support arrangements in your quotation or contract. For a product issue, send the order reference, configuration and photos to help us review it.',
      ],
      [
        'Do you charge for design or custom tooling?',
        'Ask for design, sample, tooling and production costs to be identified in the quotation. Charges depend on the requested scope; confirm ownership and reuse terms if your project requires dedicated tooling or a proprietary enclosure.',
      ],
    ],
  },
];
const faqs = faqGroups.flatMap((group) => group.items);
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'PV Combiner Box',
        item: `${SITE.url}/pv-combiner-box`,
      },
    ],
  },
];
---

<BaseLayout
  title="Custom PV Combiner Boxes & Solar Project Supply"
  description="Custom PV combiner boxes for EPC contractors, solar projects and OEM brands. Discuss circuit configuration, enclosures, project documentation and supply requirements with Soltree."
  path="/pv-combiner-box"
  image={ogImage.src}
  schema={schema}
>
  <section class="relative isolate overflow-hidden bg-[#102c24] text-white">
    <Image
      src={heroBg}
      alt=""
      widths={[960, 1440, 1942]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,24,20,0.94)_0%,rgba(4,24,20,0.78)_45%,rgba(4,24,20,0.22)_100%)]"
      aria-hidden="true"
    ></div>
    <div class="container py-10 sm:py-16">
      <nav aria-label="Breadcrumb" class="mb-10 text-sm text-green-200">
        <a href="/" class="hover:text-white">
          Home
        </a>
        <span class="mx-3" aria-hidden="true">
          /
        </span>
        <span>PV Combiner Box</span>
      </nav>
      <div class="max-w-3xl">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-300">
            Custom configurations · Project supply
          </p>
          <h1 class="mt-5 text-4xl font-bold leading-tight sm:text-5xl">
            PV Combiner Boxes.
            <br />
            <span class="text-green-300">Built Around Your Project.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-200">
            From your wiring diagram to an agreed box configuration. Work with Soltree on protection
            components, enclosure layout and OEM details for your solar project.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="#inquiry" class="btn-primary-lg">
              Discuss Your Project <span aria-hidden="true">→</span>
            </a>
            <a
              href="#customization"
              class="text-sm font-semibold text-green-200 underline underline-offset-4 hover:text-white"
            >
              Explore customization
            </a>
          </div>
          <div class="mt-10 grid gap-3 sm:grid-cols-3">
            {[
              {
                title: 'Built to Your Diagram',
                description: 'Circuit layouts and protection configured around your project.',
                icon: 'M4 4h6v6H4z M14 14h6v6h-6z M7 10v7h7 M14 7h6 M17 4v6',
              },
              {
                title: 'Your Brand, Your Box',
                description: 'Logo, nameplate and packaging options for your brand.',
                icon: 'M20 13l-7 7-10-10V3h7l10 10z M7 7h.01',
              },
              {
                title: 'Ready for Project Supply',
                description: 'Supply quantities and delivery plans agreed for your project.',
                icon: 'M3 7l9-4 9 4-9 4-9-4z M3 7v10l9 4 9-4V7 M12 11v10 M7.5 5l9 4',
              },
            ].map(({ title, description, icon }) => (
              <div class="rounded-xl border border-white/15 bg-[#0a2923]/65 p-5 backdrop-blur-sm">
                <svg
                  class="mb-4 h-6 w-6 text-green-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icon} />
                </svg>
                <h2 class="text-base font-semibold leading-snug text-white">{title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-gray-300">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="PV combiner box page sections" class="border-b border-gray-200 bg-gray-50">
    <div class="container flex flex-wrap gap-x-8 gap-y-3 py-5 text-sm font-semibold text-gray-600">
      <a href="#customization">Customization</a>
      <a href="#internal-wiring">Internal wiring</a>
      <a href="#projects">Project support</a>
      <a href="#configurations">Configuration examples</a>
      <a href="#process">How we work</a>
      <a href="#factory">Our factory</a>
      <a href="#faq">FAQs</a>
      <a href="#inquiry">Project enquiry →</a>
    </div>
  </nav>

  <section id="customization" class="py-16 sm:py-24">
    <div class="container">
      <div class="max-w-2xl">
        <p class="eyebrow">Configure the details</p>
        <h2 class="section-title mt-3">Your Project. Your Configuration.</h2>
        <p class="mt-4 leading-relaxed text-gray-600">
          Start with an existing box or your own specification. Configure these six areas around
          your installation, procurement and brand requirements.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {customization.map(([icon, title, description]) => (
          <article class="rounded-xl border border-[#dfe8e1] bg-[#f5f8f5] p-6 sm:p-7">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#e4eee5] text-green-800">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icon} />
              </svg>
            </div>
            <h3 class="mt-5 text-xl font-bold text-[#18392c]">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{description}</p>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-col gap-5 rounded-xl border border-[#dfe8e1] bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-lg font-semibold text-[#18392c]">Have a drawing or specification?</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Send it with your quantity and destination to start a configuration review.
          </p>
        </div>
        <a
          href={`mailto:${CONTACT.email}?subject=PV%20Combiner%20Box%20Project%20Drawings`}
          class="btn-primary shrink-0 self-start sm:self-auto"
        >
          Send Your Drawing <span aria-hidden="true">→</span>
        </a>
