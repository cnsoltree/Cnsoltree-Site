---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import ContactForm from '@/components/ContactForm.astro';
import { CONTACT, SITE } from '@/consts';
import { getProductById } from '@/lib/data';
import { Image, getImage } from 'astro:assets';
import heroImage from '@/assets/products/PCB-M6in-05-1.jpg';
import heroBg from '@/assets/pv-combiner-box-field-hero.png';

const customization = [
  [
    'M4 4h6v6H4z M14 14h6v6h-6z M7 10v7h7 M14 7h6 M17 4v6',
    'Circuit configuration',
    'String inputs, outputs and inverter connections matched to your diagram, with independent MPPT circuits kept separate where required.',
  ],
  [
    'M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3z M13 7l-4 6h5l-3 5',
    'Protection & switching',
    'DC breakers or isolators, PV fuses and surge protection, with ratings and coordination reviewed for your circuit.',
  ],
  [
    'M5 3h14v18H5z M8 6h8v12H8z M13 12h.01',
    'Enclosure & layout',
    'Steel or plastic housing, cable entries and internal layout planned around your installation and maintenance access.',
  ],
  [
    'M7 3v4 M11 3v4 M5 7h8v3a4 4 0 0 1-8 0V7z M9 14v3a4 4 0 0 0 8 0v-3 M15 10h4v4h-4z',
    'Wiring & connections',
    'Cable sizes, connectors, polarity markings and internal routing specified for the approved configuration.',
  ],
  [
    'M20 13l-7 7-10-10V3h7l10 10z M7 7h.01',
    'OEM identification',
    'Your logo, nameplate, circuit labels and packaging for a consistent brand presentation.',
  ],
  [
    'M14 3H5v18h14V8l-5-5z M14 3v5h5 M8 12h8 M8 16h6',
    'Project documentation',
    'Drawings, component lists and inspection records, with market-specific document requirements reviewed for your project.',
  ],
];
const projects = [
  [
    'Commercial & industrial rooftops',
    'Plan configurations around roof zones, inverter connections and maintenance access, with clear circuit identification across the installation.',
    'M3 11l9-7 9 7 M5 10v10h14V10 M8 20v-6h8v6 M8 8h8',
  ],
  [
    'Ground-mount solar projects',
    'Discuss enclosure requirements, cable entries and supply batches around the site environment and project delivery schedule.',
    'M5 4h14l3 12H2L5 4z M4 10h16 M9 4l-1 12 M15 4l1 12 M9 16v4 M15 16v4 M6 20h12',
  ],
  [
    'OEM & distribution partners',
    'Agree a repeat-order configuration with consistent components, brand identification and packaging requirements for your market.',
    'M3 7l9-4 9 4-9 4-9-4z M3 7v10l9 4 9-4V7 M12 11v10 M7.5 5l9 4',
  ],
];
const workflow = [
  [
    'Project brief',
    'Share your drawing, inverter details, quantity and destination. Flag any requirements still to be decided.',
  ],
  [
    'Configuration review',
    'Review the circuit, protection components, enclosure layout and required documents together.',
  ],
  [
    'Specification approval',
    'Approve drawings and the component list before production. Confirm whether a sample or first article is needed.',
  ],
  [
    'Production & delivery',
    'Coordinate inspection, labeling, packing and shipment batches against the agreed delivery plan.',
  ],
];
// Show “Read the full project” only once the case page exists, so visitors never hit a 404.
const casePages = Object.keys(import.meta.glob('/src/pages/projects/*.astro')).map((file) =>
  file.replace('/src/pages', '').replace(/.astro$/, ''),
);
const references = [
  {
    id: 'HT-8Way-2in1out-600VDC',
    caseHref: '/projects/plastic-combiner-box-south-africa-rooftop',
    image: '/images/uploads/ht-8way-rooftop-installed.png',
    imageAlt: 'HT 8-way plastic PV combiner box wall-mounted beside a rooftop solar array',
    title: '2-in / 1-out Plastic Combiner Box',
    enclosure: 'Plastic enclosure',
    customer: 'Solar installer / South Africa / Rooftop PV',
    application:
      'Two rooftop strings combined into one inverter input, supplied as a pre-wired box the installer reorders under one part number.',
    specs: [
      ['Inputs / outputs', '2 in / 1 out'],
      ['Max system voltage', '600V DC'],
      ['DC breaker', '63A'],
      ['PV fuses', '4 × 15A'],
      ['Surge protection', '500V DC · 40kA'],
      ['Enclosure', 'Flame-retardant plastic · IP65'],
    ],
    why: 'A compact, lightweight housing for wall mounting on residential roofs, with the same layout on every repeat order.',
  },
  {
    id: 'PCB-M6in-05',
    caseHref: '/projects/steel-combiner-box-multi-string-pv',
    image: '/images/uploads/steel-combiner-box-carport-installed.png',
    imageAlt: 'Steel PV combiner box mounted on a solar carport column with cable tray',
    title: '6-input Steel Combiner Box',
    enclosure: 'Steel enclosure',
    customer: 'Engineering procurement / Multi-string PV',
    application:
      'Six PV strings combined into one 125A output for a larger array, with internal space for organized wiring and maintenance.',
    specs: [
      ['Inputs / outputs', '6 in / 1 out'],
      ['DC breaker', '125A'],
      ['PV fuses', '6 × 15A'],
      ['Surge protection', '500V DC · 40kA'],
      ['Enclosure', 'Steel · IP65'],
      ['Security', 'Safety lock & key'],
    ],
    why: 'A steel, lockable enclosure for sites where the box is exposed to impact or unauthorized access.',
  },
].map((item) => ({ ...item, product: getProductById(item.id)! }));
const faqs = [
  [
    'Can you customize a PV combiner box to our drawing?',
    'Yes. Send your single-line diagram, component requirements and enclosure layout, or start with an existing configuration. We will review feasibility and confirm the final scope in the quotation and approved specification.',
  ],
  [
    'What can be customized?',
    'Circuit inputs and outputs, protection components, enclosure layout, cable entries, connections, labels and packaging can be discussed. Availability depends on the selected design, component compatibility and order quantity.',
  ],
  [
    'Can you support an EPC project or a tender enquiry?',
    'Yes. Share the technical schedule, bill of quantities, required documents, destination and delivery milestones. Identify mandatory requirements so the proposed configuration and supply scope can be reviewed against them.',
  ],
  [
    'Can one box serve multiple inverter MPPT inputs?',
    'The layout must preserve the circuit arrangement required by the inverter. Send the inverter model and wiring diagram so independent circuits and any combining points can be reviewed before a configuration is agreed.',
  ],
  [
    'What are the MOQ and lead time for custom orders?',
    'MOQ and lead time are quoted for the agreed configuration. They depend on enclosure changes, component availability, branding, sample requirements and quantity. Include your target delivery date with the enquiry.',
  ],
  [
    'Which certificates and inspection documents can you provide?',
    'Send the standards, certificates and inspection records required by your project or market. We will confirm which documents apply to the proposed assembly and components. Component certificates do not automatically certify the complete box.',
  ],
  [
    'Do you offer samples before a project order?',
    'Request a sample or first article with your enquiry. Its specification, cost and schedule will be confirmed before proceeding; agree any approval criteria before production.',
  ],
  [
    'How do I send project drawings?',
    `Email your drawings, bill of quantities and specification to ${CONTACT.email}. You can also send an initial brief through the form below and reference the project name when following up by email.`,
  ],
];
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'PV Combiner Box',
        item: `${SITE.url}/pv-combiner-box`,
      },
    ],
  },
];
---

<BaseLayout
  title="Custom PV Combiner Boxes & Solar Project Supply"
  description="Custom PV combiner boxes for EPC contractors, solar projects and OEM brands. Discuss circuit configuration, enclosures, project documentation and supply requirements with Soltree."
  path="/pv-combiner-box"
  image={ogImage.src}
  schema={schema}
>
  <section class="relative isolate overflow-hidden bg-[#102c24] text-white">
    <Image
      src={heroBg}
      alt=""
      widths={[960, 1440, 1942]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(4,24,20,0.94)_0%,rgba(4,24,20,0.78)_45%,rgba(4,24,20,0.22)_100%)]"
      aria-hidden="true"
    ></div>
    <div class="container py-10 sm:py-16">
      <nav aria-label="Breadcrumb" class="mb-10 text-sm text-green-200">
        <a href="/" class="hover:text-white">
          Home
        </a>
        <span class="mx-3" aria-hidden="true">
          /
        </span>
        <span>PV Combiner Box</span>
      </nav>
      <div class="max-w-3xl">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-300">
            Custom configurations · Project supply
          </p>
          <h1 class="mt-5 text-4xl font-bold leading-tight sm:text-5xl">
            PV Combiner Boxes.
            <br />
            <span class="text-green-300">Built Around Your Project.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-200">
            From your wiring diagram to an agreed box configuration. Work with Soltree on protection
            components, enclosure layout and OEM details for your solar project.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="#inquiry" class="btn-primary-lg">
              Discuss Your Project <span aria-hidden="true">→</span>
            </a>
            <a
              href="#customization"
              class="text-sm font-semibold text-green-200 underline underline-offset-4 hover:text-white"
            >
              Explore customization
            </a>
          </div>
          <div class="mt-10 grid gap-3 sm:grid-cols-3">
            {[
              {
                title: 'Built to Your Diagram',
                description: 'Circuit layouts and protection configured around your project.',
                icon: 'M4 4h6v6H4z M14 14h6v6h-6z M7 10v7h7 M14 7h6 M17 4v6',
              },
              {
                title: 'Your Brand, Your Box',
                description: 'Logo, nameplate and packaging options for your brand.',
                icon: 'M20 13l-7 7-10-10V3h7l10 10z M7 7h.01',
              },
              {
                title: 'Ready for Project Supply',
                description: 'Supply quantities and delivery plans agreed for your project.',
                icon: 'M3 7l9-4 9 4-9 4-9-4z M3 7v10l9 4 9-4V7 M12 11v10 M7.5 5l9 4',
              },
            ].map(({ title, description, icon }) => (
              <div class="rounded-xl border border-white/15 bg-[#0a2923]/65 p-5 backdrop-blur-sm">
                <svg
                  class="mb-4 h-6 w-6 text-green-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icon} />
                </svg>
                <h2 class="text-base font-semibold leading-snug text-white">{title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-gray-300">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="PV combiner box page sections" class="border-b border-gray-200 bg-gray-50">
    <div class="container flex flex-wrap gap-x-8 gap-y-3 py-5 text-sm font-semibold text-gray-600">
      <a href="#customization">Customization</a>
      <a href="#projects">Project support</a>
      <a href="#configurations">Configuration examples</a>
      <a href="#process">How we work</a>
      <a href="#faq">FAQs</a>
      <a href="#inquiry">Project enquiry →</a>
    </div>
  </nav>

  <section id="customization" class="py-16 sm:py-24">
    <div class="container">
      <div class="max-w-2xl">
        <p class="eyebrow">Configure the details</p>
        <h2 class="section-title mt-3">Your Project. Your Configuration.</h2>
        <p class="mt-4 leading-relaxed text-gray-600">
          Start with an existing box or your own specification. Configure these six areas around
          your installation, procurement and brand requirements.
        </p>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {customization.map(([icon, title, description]) => (
          <article class="rounded-xl border border-[#dfe8e1] bg-[#f5f8f5] p-6 sm:p-7">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#e4eee5] text-green-800">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icon} />
              </svg>
            </div>
            <h3 class="mt-5 text-xl font-bold text-[#18392c]">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{description}</p>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-col gap-5 rounded-xl border border-[#dfe8e1] bg-white p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-lg font-semibold text-[#18392c]">Have a drawing or specification?</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Send it with your quantity and destination to start a configuration review.
          </p>
        </div>
        <a
          href={`mailto:${CONTACT.email}?subject=PV%20Combiner%20Box%20Project%20Drawings`}
          class="btn-primary shrink-0 self-start sm:self-auto"
        >
          Send Your Drawing <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="configurations" class="border-t border-gray-100 pb-16 pt-12 sm:pb-24 sm:pt-16">
    <div class="container">
      <div class="max-w-3xl">
        <p class="eyebrow">Project configuration examples</p>
        <h2 class="section-title mt-3">From Project Brief to Box Configuration.</h2>
        <p class="mt-4 leading-relaxed text-gray-600">
          Two customer projects, one plastic and one steel, showing how the box configuration
          follows the string count, current and installation site.
        </p>
      </div>
      <div class="mt-10 space-y-10">
        {references.map(
          ({
            title,
            enclosure,
            customer,
            application,
            specs,
            why,
            caseHref,
            image,
            imageAlt,
            product,
          }) => (
            <article class="grid items-start gap-6 border-t border-[#dfe8e1] pt-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
              <div class="overflow-hidden rounded-xl">
                <Img
                  src={image ?? product.image}
                  alt={imageAlt ?? product.name}
                  width={800}
                  class="aspect-square w-full object-cover"
                />
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                  <span class="rounded-full bg-[#edf3ee] px-3 py-1 text-green-800">
                    {enclosure}
                  </span>
                  <span class="text-gray-500">Customer project</span>
                </div>
                <h3 class="mt-4 text-2xl font-bold text-[#18392c] sm:text-3xl">{title}</h3>
                <p class="mt-2 text-sm font-medium text-green-800">{customer}</p>
                <p class="mt-4 leading-relaxed text-gray-600">{application}</p>
                <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-[#dfe8e1] bg-[#dfe8e1] sm:grid-cols-3">
                  {specs.map(([label, value]) => (
                    <div class="bg-white px-4 py-3">
                      <dt class="text-xs text-gray-500">{label}</dt>
                      <dd class="mt-1 text-sm font-semibold text-[#18392c]">{value}</dd>
                    </div>
                  ))}
                </dl>
                <p class="mt-5 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-[#18392c]">Why this enclosure: </span>
                  {why}
                </p>
                {casePages.includes(caseHref) && (
                  <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3 font-semibold text-green-800">
                    <a
                      href={caseHref}
                      class="inline-flex items-center gap-2 underline-offset-4 hover:underline"
                    >
                      Read the full project <span aria-hidden="true">→</span>
                    </a>
                  </div>
                )}
              </div>
            </article>
          ),
        )}
      </div>
    </div>
  </section>

  <section id="projects" class="bg-[#f5f7f4] py-16 sm:py-24">
    <div class="container">
      <div class="max-w-3xl">
        <p class="eyebrow">Applications & partnerships</p>
        <h2 class="section-title mt-3">Built for Solar Projects & OEM Partners.</h2>
        <p class="mt-4 leading-relaxed text-gray-600">
          Work with Soltree as an EPC contractor, solar installer or OEM partner to align the box
          configuration with your installation and procurement requirements.
        </p>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6 lg:gap-10">
        {projects.map(([title, description, icon]) => (
          <article class="border-t border-[#d5e1d7] pt-6">
            <svg
              class="h-8 w-8 text-green-700"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icon} />
            </svg>
            <h3 class="mt-5 text-xl font-bold text-[#18392c]">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{description}</p>
          </article>
        ))}
      </div>
      <a href="#inquiry" class="btn-primary mt-8">
        Discuss Your Project <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section id="process" class="bg-[#102c24] py-16 text-white sm:py-24">
    <div class="container">
      <p class="text-sm font-semibold uppercase tracking-widest text-green-300">
        From enquiry to supply
      </p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">From Your Drawing to Project Delivery.</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-gray-300">
        Agree the configuration, approval requirements and supply scope before production begins.
      </p>
      <ol class="mt-10 grid list-none p-0 lg:grid-cols-4">
        {workflow.map(([title, description], index) => (
          <li class="group relative pb-8 pl-16 last:pb-0 lg:pb-0 lg:pl-0 lg:pr-8 lg:last:pr-0">
            <div
              class="absolute bottom-0 left-[22px] top-0 w-px bg-white/20 group-last:hidden lg:bottom-auto lg:left-0 lg:top-[22px] lg:h-px lg:w-full"
              aria-hidden="true"
            ></div>
            <span class="absolute left-0 top-0 flex h-11 w-11 items-center justify-center rounded-full border border-green-300/50 bg-[#102c24] text-sm font-semibold text-green-300 lg:relative">
              <span class="sr-only">Step </span>0{index + 1}
            </span>
            <h3 class="pt-2 text-xl font-semibold lg:mt-6 lg:pt-0">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-300">{description}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 border-t border-white/15 pt-6">
        <a
          href="#inquiry"
          class="inline-flex items-center gap-3 font-semibold text-green-300 underline-offset-4 hover:text-white hover:underline"
        >
          Start with your project drawing <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="faq" class="py-16 sm:py-24">
    <div class="container">
      <p class="eyebrow">Before you send an enquiry</p>
      <h2 class="section-title mt-3">Custom PV Combiner Box FAQs</h2>
      <div class="mt-10 grid items-start gap-x-12 lg:grid-cols-2">
        {faqs.map(([question, answer]) => (
          <details class="group border-b border-gray-200">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-5 text-base font-semibold">
              <span>{question}</span>
              <span aria-hidden="true" class="text-xl text-green-700 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="pb-6 text-sm leading-relaxed text-gray-600">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="inquiry" class="bg-[#edf3ee] py-16 sm:py-24">
    <div class="container grid items-center gap-10 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Custom box · OEM · Project quotation</p>
        <h2 class="section-title mt-3">Tell Us What Your Project Needs.</h2>
        <p class="mt-5 leading-relaxed text-gray-600">
          Have a complete specification or just an initial layout? Send what you have and tell us
          which details need support.
        </p>
        <ul class="mt-7 space-y-3 text-sm text-gray-700">
          <li>01 — Inverter model, string inputs and output arrangement</li>
          <li>02 — Design voltage, current and protection requirements</li>
          <li>03 — Enclosure, installation environment and branding</li>
          <li>04 — Quantity, destination, documents and target delivery</li>
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-gray-600">
          For drawings and attachments, email us directly with your project name.
        </p>
        <div class="mt-7 flex flex-col items-start gap-3 border-t border-green-900/15 pt-6 text-sm font-semibold text-green-900">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={`tel:${CONTACT.phone.replace(/\s/g, '')}`}>{CONTACT.phone}</a>
          <a
            href={`https://wa.me/${CONTACT.whatsapp}?text=Hello%2C%20I%20have%20a%20PV%20combiner%20box%20project%20enquiry.`}
            target="_blank"
            rel="noopener"
          >
            Discuss on WhatsApp →
          </a>
        </div>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-8">
        <h3 class="text-xl font-bold">Request a Project Review</h3>
        <p class="mb-6 mt-2 text-sm text-gray-500">
          Share your requirements for a configuration and quotation discussion.
        </p>
        <ContactForm
          showCountry
          showSubject
          defaultSubject="PV Combiner Box — Custom / Project Enquiry"
          messagePlaceholder={
            'Project / destination market:\nInverter model & string layout:\nDesign voltage & current:\nEnclosure / OEM requirements:\nQuantity & target delivery:\nRequired documentation:'
          }
          buttonText="Send Project Enquiry"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section[id] {
    scroll-margin-top: 6rem;
  }
  .eyebrow {
    color: #15803d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .section-title {
    color: #182b23;
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  nav[aria-label='PV combiner box page sections'] a:hover {
    color: #15803d;
  }
</style>
