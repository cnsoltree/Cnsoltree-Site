---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import ContactForm from '@/components/ContactForm.astro';
import { CONTACT, SITE } from '@/consts';
import { getImage } from 'astro:assets';
import rangeImage from '@/assets/uploads/dc-surge-protector-range.png';
import stdImage from '@/assets/uploads/std-40-pv-1000v-color-range.png';
import std600Image from '@/assets/uploads/std-40-pv-600v-color-range.png';

// Two core Type 2 configurations; keep links aligned with the product detail pages.
const badges = [
  [
    'Type 2 / Class II',
    'For induced lightning and switching surges',
    'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6',
  ],
  ['In 20kA / Imax 40kA', '8/20μs discharge ratings', 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z'],
  ['600V 2P / 1000V 3P', 'Two core PV configurations', 'M3 19h18M5 15l5-5 4 2 5-8M15 4h4v4'],
  ['Pluggable design', '35mm DIN rail mounting', 'M6 3v18M18 3v18M6 7h12M6 17h12M9 10l3 3 3-3'],
];
const series = [
  {
    model: 'STD-40-PV',
    name: 'Type 2 600V 2P DC Surge Protector SPD STD-40-PV',
    type: 'Type 2 / 600V DC / 2P',
    voltage: '600',
    poles: '2P',
    up: '2.8',
    href: '/products/STD-40-PV-600V',
    image: '/images/uploads/std-40-pv-600v-color-range.png',
    asset: std600Image,
    description:
      'A 2-pole Type 2 DC SPD for 600V PV circuits, installed in a string combiner box or near the inverter DC input. Review its specifications, 2P drawings and combiner-box installation example on the product page.',
    rows: [
      ['Configuration', '600V DC / 2P / Type 2'],
      ['Surge ratings', 'In 20kA / Imax 40kA (8/20μs)'],
      ['Maintenance', 'Replaceable plug-in MOV modules'],
      ['Product guide', 'Specifications, wiring, installation and 2P dimensions'],
    ],
  },
  {
    model: 'STD-40-PV',
    name: 'Type 2 1000V 3P DC Surge Protector SPD STD-40-PV',
    type: 'Type 2 / 1000V DC / 3P',
    voltage: '1000',
    poles: '3P',
    up: '3.8',
    href: '/products/STD-40-PV-1000V',
    image: '/images/uploads/std-40-pv-1000v-color-range.png',
    asset: stdImage,
    description:
      'A 3-pole Type 2 DC SPD for 1000V PV circuits, for use at the string combiner box or inverter DC side. Review the electrical ratings and wiring diagram against your PV circuit and earthing arrangement before ordering.',
    rows: [
      ['Configuration', '1000V DC / 3P / Type 2'],
      ['Surge ratings', 'In 20kA / Imax 40kA (8/20μs)'],
      ['Maintenance', 'Replaceable plug-in MOV modules'],
      ['Product guide', 'Specifications, wiring, installation and dimensions'],
    ],
  },
];
// Certificate scans: put the file in src/assets/uploads/ and set image to '/images/uploads/<file>'.
// Empty slots show a placeholder in local dev only and are left out of the production page.
const certificates = [
  { name: 'CE', caption: 'Low Voltage Directive 2014/35/EU', image: '' },
  { name: 'TÜV', caption: 'Tested to IEC 61643-31 / EN 61643-31', image: '' },
  { name: 'CB', caption: 'IECEE CB Scheme test certificate', image: '' },
];
const visibleCertificates = certificates.filter((cert) => cert.image || import.meta.env.DEV);
const materials = [
  [
    'Varistor chip',
    '34S square MOV (34×34mm), epoxy encapsulated',
    'Smaller round discs, bare chips',
    'Larger chips carry more surge energy; encapsulation resists moisture and flashover',
  ],
  [
    'Contact pins',
    'Brass (pluggable type)',
    'Iron',
    'Better conductivity, spring force and corrosion resistance',
  ],
  [
    'Internal conductor',
    'Pure copper',
    'Brass or iron',
    'Lower resistance, less heat during surge discharge',
  ],
  ['Base terminals', 'Copper', 'Iron', 'Stable clamping and lower contact resistance over time'],
  [
    'Housing',
    'Flame-retardant PC, UL94 V-0',
    'V-1 / V-2 grade plastics',
    'V-0 is the highest flammability rating in its class',
  ],
];
const applications = [
  [
    'Residential rooftop PV',
    'For the PV DC side of home solar installations, with protection planned at the combiner box or near the inverter input. Allow access for inspection and replacement, even in compact enclosures.',
    'Maximum string voltage, enclosure space and service access.',
  ],
  [
    'C&I rooftop',
    'For factories, warehouses and commercial roofs with multiple PV strings. Plan around the combiner and inverter locations, with a layout that supports routine inspection and scheduled maintenance.',
    'String layout, inverter locations and existing lightning protection.',
  ],
  [
    'Ground-mount power stations',
    'For field arrays using string combiner boxes or distributed inverters. Review protection locations alongside the DC cable routes and the site earthing and lightning protection design.',
    'DC cable lengths, system voltage and the site protection plan.',
  ],
  [
    'Energy storage & hybrid inverters',
    'For the solar-input side of hybrid inverter systems. Review the independent MPPT circuits against the inverter wiring diagram; battery-side protection requires a separate compatibility assessment.',
    'Inverter model, MPPT count and PV-side wiring diagram.',
  ],
  [
    'RV & off-grid solar',
    'For compact PV distribution boxes in mobile and standalone solar systems. Review the actual array voltage and available mounting space, rather than choosing by installation size alone.',
    'Array voltage, controller model and available DIN rail space.',
  ],
];
const faqGroups = [
  {
    id: 'faq-selection',
    title: 'Selection & installation',
    items: [
      [
        'Do I need a surge protector for my solar system?',
        'A PV surge protection plan should consider the DC side as well as the AC side. Whether protection is required and which type to use depend on local installation rules, site exposure and the lightning protection design. Have your installer confirm the requirements for your project.',
      ],
      [
        'What is the difference between a DC SPD and an AC SPD?',
        'Use an SPD specifically rated for the circuit. PV DC and AC devices differ in their voltage ratings, internal arrangements and test requirements. An AC mains SPD is not a substitute for a PV-rated DC SPD.',
      ],
      [
        'What Ucpv do I need for a 1000V system?',
        'Choose a Ucpv equal to or higher than the maximum PV string open-circuit voltage. Calculate that voltage at the lowest expected site temperature: if it stays within 1000V, a 1000V-rated SPD can fit; if it exceeds 1000V, neither of the two models on this page is suitable. The protection level Up and circuit arrangement must also suit the equipment. Do not select a voltage class from the inverter nameplate alone. Share the string calculation and inverter data for selection support.',
      ],
      [
        'Type 1 or Type 2 for solar?',
        'Most rooftop and ground-mount PV systems without an external lightning protection system use Type 2 SPDs, which address induced and switching surges. Where lightning currents can enter the installation, Type 1 or combined Type 1+2 protection may be needed. The external lightning protection system and its separation distance affect this decision. Both STD-40-PV models shown on this page are Type 2; have your designer confirm the protection concept.',
      ],
      [
        'Where should the DC SPD be installed?',
        'Common locations include PV combiner boxes and the DC side near the inverter. Cable lengths, routing and the lightning protection design determine whether additional protection points are needed. Have your installer confirm the locations and connection layout using the selected device instructions.',
      ],
      [
        'What is the difference between 2P and 3P DC SPDs?',
        'Pole count alone does not define the protection circuit. Compare the wiring diagrams, protected modes and earthing arrangement. A 3P label does not by itself confirm a Y circuit or suitability for a particular system. Send your inverter model and DC wiring diagram so the configuration can be reviewed.',
      ],
    ],
  },
  {
    id: 'faq-ordering',
    title: 'Maintenance & ordering',
    items: [
      [
        'Does an SPD need replacing after a lightning strike?',
        'Not automatically after every event. Check the status indicator and have the device and its connections inspected after a significant surge. Replace a failed unit as instructed by the manufacturer. For a pluggable model, confirm the replacement module matches the base and that the base remains serviceable.',
      ],
      [
        'Can you supply private label SPDs?',
        'Yes. Housing color, logo, labeling and packaging can be customized, with MOQ starting at 100 pieces per model. Share your artwork, target configuration and quantity. Confirm the final specification and delivery schedule with your quotation.',
      ],
      [
        'What information should I send for a quotation?',
        'Send the inverter model, string layout, maximum string voltage if known, quantity and destination market. Include your wiring diagram, required documentation and any color, logo or packaging requirements. If the configuration is still open, tell us which details need review.',
      ],
      [
        'Can you supply SPDs in a pre-wired PV combiner box?',
        'Yes. Our PV combiner box range includes configurations with DC SPDs and breakers pre-installed. Share the string count, inverter model and enclosure requirements so the available configuration can be checked against your project.',
      ],
    ],
  },
];
const faqs = faqGroups.flatMap((group) => group.items);
const ogImage = await getImage({ src: rangeImage, width: 1200, format: 'jpg' });
const seriesImages = await Promise.all(
  series.map((item) => getImage({ src: item.asset, width: 960, format: 'webp' })),
);
const pageUrl = `${SITE.url}/dc-surge-protector`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
  ...series.map((item, index) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: item.name,
    description: item.description,
    image: new URL(seriesImages[index].src, SITE.url).href,
    model: item.model,
    category: 'Surge Protective Device (SPD)',
    url: new URL(item.href, SITE.url).href,
    brand: { '@type': 'Brand', name: 'Soltree' },
    manufacturer: { '@id': `${SITE.url}/#organization` },
    additionalProperty: [
      ['SPD type', 'Type 2 / Class II'],
      ['Max. continuous PV voltage (Ucpv)', `${item.voltage} V DC`],
      ['Voltage protection level (Up)', `${item.up} kV`],
      ['Nominal discharge current (In, 8/20μs)', '20 kA'],
      ['Maximum discharge current (Imax, 8/20μs)', '40 kA'],
      ['Response time', '≤25 ns'],
      ['Poles', item.poles],
      ['Standard', 'IEC 61643-31 / EN 61643-31'],
      ['Certifications', 'CE, TÜV, CB'],
      ...item.rows.filter(([label]) => label !== 'Best for'),
    ].map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'DC Surge Protector',
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title="DC Surge Protector for Solar PV | 600V 2P &amp; 1000V 3P Type 2 SPD | Soltree"
  description="Type 2 DC surge protectors for solar PV: 600V 2P and 1000V 3P STD-40-PV, In 20kA / Imax 40kA. Compare specifications, wiring diagrams and installation details."
  path="/dc-surge-protector"
  image={ogImage.src}
  schema={schema}
>
  <section class="spd-hero overflow-hidden bg-[#102c24] text-white">
    <div class="container py-12 sm:py-20">
      <nav aria-label="Breadcrumb" class="mb-10 text-sm text-green-200">
        <a href="/" class="hover:text-white">
          Home
        </a>
        <span aria-hidden="true" class="mx-3">
          /
        </span>
        <span>DC Surge Protector</span>
      </nav>
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-green-300">
            Solar PV Surge Protection
          </p>
          <h1 class="mt-4 text-[2.125rem] font-bold leading-tight sm:text-[3.375rem]">
            DC Surge Protectors for Solar PV Systems,{' '}
            <span class="text-green-300">600V 2P &amp; 1000V 3P</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-200">
            Type 2 DC SPDs that protect inverters, PV modules and combiner boxes against induced
            lightning and switching overvoltage. Factory-direct from Soltree, with CE, TÜV and CB
            certification and OEM from 100 pieces.
          </p>
          <div class="mt-8 grid gap-x-6 gap-y-5 sm:grid-cols-2">
            {badges.map(([title, description, icon]) => (
              <div class="flex items-start gap-3">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/30 bg-white/10"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                  >
                    <path d={icon} />
                  </svg>
                </span>
                <div>
                  <p class="text-sm font-bold text-white">{title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-gray-300">{description}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#inquiry" class="btn-primary-lg">
              Get a Quote <span aria-hidden="true">→</span>
            </a>
            <a href="#selection" class="btn-primary-lg">
              View Selection Table <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="relative rounded-2xl bg-[#f5f7f4] p-6 text-gray-900 shadow-2xl sm:p-10">
          <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-widest text-gray-500">
            <span>DC SPD range</span>
            <span>Type 2</span>
          </div>
          <Img
            src="/images/uploads/dc-surge-protector-range.png"
            alt="Soltree DC surge protector range in eight housing and module color combinations"
            width={1536}
            height={1024}
            priority
            class="mt-6 h-auto w-full rounded-xl object-contain"
          />
          <p class="mt-6 border-t border-gray-200 pt-5 text-sm text-gray-500">
            CE · TÜV · CB certified · MOQ 100 pcs · 7-day lead time · Custom color, logo and
            packaging
          </p>
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="DC SPD page sections" class="border-b border-gray-200 bg-gray-50">
    <div class="container flex flex-wrap gap-x-8 gap-y-3 py-5 text-sm font-semibold text-gray-600">
      <a href="#overview">How it works</a>
      <a href="#series">Product range</a>
      <a href="#selection">Selection</a>
      <a href="#materials">Materials</a>
      <a href="#applications">Applications</a>
      <a href="#faq">FAQs</a>
    </div>
  </nav>

  <section id="overview" class="container py-16 sm:py-20" aria-labelledby="overview-heading">
    <div>
      <div class="max-w-2xl">
        <p class="section-eyebrow">How it works</p>
        <h2 id="overview-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
          What Does a DC Surge Protector Do?
        </h2>
      </div>
      <p class="mt-5 leading-relaxed text-gray-600">
        A DC surge protector (SPD) sits between the PV conductors and earth. Under normal operation
        it stays at high impedance and has no effect on the system. When a surge appears on the DC
        line, it responds within 25 nanoseconds, diverts the surge current to earth and limits the
        voltage that reaches the inverter. Once the surge has passed, it returns to high impedance
        automatically.
      </p>
      <ol class="mt-6 grid overflow-hidden rounded-2xl border border-gray-200 md:grid-cols-3">
        {[
          ['Normal operation', 'High impedance. No leakage, no effect on power generation.'],
          ['Surge event', 'Conducts within ≤25ns and diverts surge current to earth.'],
          ['Recovery', 'Returns to high impedance and stays ready for the next event.'],
        ].map(([title, text], index) => (
          <li
            class:list={[
              'p-6 sm:p-8',
              index === 1 && 'border-y border-gray-200 bg-[#edf3ee] md:border-x md:border-y-0',
            ]}
          >
            <div class="flex items-center gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-green-700/20 bg-white text-xs font-bold text-green-700">
                0{index + 1}
              </span>
              <h3 class="text-lg font-semibold">{title}</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-gray-600">{text}</p>
          </li>
        ))}
      </ol>
      <aside
        class="mt-6 grid gap-3 rounded-xl bg-gray-50 p-6 sm:p-8 md:grid-cols-[13rem_1fr] md:gap-8"
        aria-labelledby="overview-why"
      >
        <h3 id="overview-why" class="text-base font-semibold text-gray-900 md:self-center">
          Why PV systems need it:
        </h3>
        <p class="text-sm leading-relaxed text-gray-600">
          PV arrays cover a large area, often on exposed rooftops and open ground, with long DC
          cable runs. A lightning strike nearby can induce thousands of volts on those cables.
          Without an SPD, that voltage reaches the inverter input, which is usually the most
          expensive single component in the system.
        </p>
      </aside>
    </div>
  </section>

  <section id="series" class="bg-gray-50 py-16 sm:py-24">
    <div class="container">
      <div class="max-w-2xl">
        <p class="section-eyebrow">Product range</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">DC Surge Protector Product Range</h2>
        <p class="mt-5 leading-relaxed text-gray-600">
          Choose between two STD-40-PV Type 2 models: 600V 2P and 1000V 3P. Each has a dedicated
          product page with electrical specifications, installation information and wiring diagrams
          to help you review the right configuration for your project.
        </p>
      </div>
      <div class="mt-8 grid gap-5">
        {series.map((item) => (
          <article class="grid overflow-hidden rounded-xl border border-gray-200 bg-white sm:grid-cols-[14rem_minmax(0,1fr)] lg:grid-cols-[18rem_minmax(0,1fr)]">
            <div class="relative h-64 bg-white sm:h-auto">
              <Img
                src={item.image}
                alt={`Soltree ${item.type} STD-40-PV DC surge protector`}
                fill
                width={960}
                class="object-contain p-4"
              />
            </div>
            <div class="flex flex-col border-t border-gray-100 p-6 sm:border-l sm:border-t-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-green-700">
                {item.type}
              </p>
              <h3 class="mt-2 text-2xl font-bold">{item.name}</h3>
              <p class="mt-4 text-sm leading-relaxed text-gray-600">{item.description}</p>
              <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2">
                {item.rows.map(([label, value]) => (
                  <div>
                    <dt class="text-gray-500">{label}</dt>
                    <dd class="mt-1 font-medium">{value}</dd>
                  </div>
                ))}
              </dl>
              <a
                href={item.href}
                class="mt-auto inline-block pt-6 text-sm font-semibold text-green-700"
              >
                {`View ${item.voltage}V ${item.poles} details`} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="selection" class="container py-16 sm:py-24">
    <p class="section-eyebrow">Selection</p>
    <h2 id="selection-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
      DC SPD Selection Table
    </h2>
    <p class="mt-5 leading-relaxed text-gray-600">
      Compare pole counts, PV voltage ratings (Ucpv), protection levels (Up) and discharge current
      ratings for the 600V 2P and 1000V 3P STD-40-PV models. Use this table to shortlist a
      configuration, then follow the three-step guide below to review your selection.
    </p>
    <div
      class="mt-10 overflow-x-auto"
      role="region"
      aria-label="DC SPD selection table"
      tabindex="0"
    >
      <table
        class="spd-table w-full min-w-[720px] text-center text-sm"
        aria-labelledby="selection-heading"
      >
        <thead>
          <tr>
            <th scope="col">Model</th>
            <th scope="col">Poles</th>
            <th scope="col">Ucpv (V DC)</th>
            <th scope="col">Up (kV)</th>
            <th scope="col">In (kA, 8/20μs)</th>
            <th scope="col">Imax (kA, 8/20μs)</th>
          </tr>
        </thead>
        <tbody>
          {series.map((item) => (
            <tr>
              <th scope="row">
                <a href={item.href} class="text-green-700 underline underline-offset-4">
                  STD-40-PV {item.voltage}V
                </a>
              </th>
              <td>{item.poles}</td>
              <td>{item.voltage}</td>
              <td>{item.up}</td>
              <td>20</td>
              <td>40</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2
      id="selection-guide-heading"
      class="mt-16 max-w-3xl text-balance text-2xl font-bold leading-tight sm:mt-20 sm:text-3xl"
    >
      How to Choose a DC Surge Protector in 3 Steps
    </h2>
    <ol
      class="mt-8 divide-y divide-gray-200 border-y border-gray-200"
      aria-labelledby="selection-guide-heading"
    >
      <li class="grid gap-5 py-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12 lg:py-10">
        <div class="lg:self-center">
          <p class="text-xs font-bold text-green-700">STEP 1</p>
          <h3 class="mt-3 text-xl font-semibold leading-snug">
            Match Ucpv to the maximum string voltage
          </h3>
        </div>
        <div class="min-w-0 space-y-4">
          <p class="text-sm leading-relaxed text-gray-600">
            Ucpv must be equal to or higher than the highest open-circuit voltage the string can
            reach. Voc rises as temperature falls, so calculate it at the lowest expected site
            temperature, not at 25°C.
          </p>
          <p class="text-sm leading-relaxed text-gray-600">
            Compare the calculated maximum string voltage with the selected model: 600V DC for the
            2P version or 1000V DC for the 3P version. If the maximum exceeds 1000V, neither model
            on this page is suitable. Use the module temperature coefficient and site design data
            for the calculation.
          </p>
          <p class="rounded-lg border-l-2 border-red-400 bg-red-50 p-4 text-sm leading-relaxed text-red-800">
            Never choose an SPD whose Ucpv is below the maximum string voltage. It will conduct
            during normal operation, overheat and fail.
          </p>
        </div>
      </li>
      <li class="grid gap-5 py-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12 lg:py-10">
        <div class="lg:self-center">
          <p class="text-xs font-bold text-green-700">STEP 2</p>
          <h3 class="mt-3 text-xl font-semibold leading-snug">Choose the protection type</h3>
        </div>
        <div class="min-w-0">
          <p class="text-sm leading-relaxed text-gray-600">
            Both models on this page are Type 2 / Class II SPDs for induced lightning and switching
            surges, with 8/20μs discharge ratings. Confirm that your project requires Type 2
            protection before choosing between the 600V 2P and 1000V 3P models.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-gray-600">
            If the site design requires Type 1, combined Type 1+2 or Type 3 protection, have your
            designer specify the appropriate device and coordination. These two models are Type 2
            only.
          </p>
        </div>
      </li>
      <li class="grid gap-5 py-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12 lg:py-10">
        <div class="lg:self-center">
          <p class="text-xs font-bold text-green-700">STEP 3</p>
          <h3 class="mt-3 text-xl font-semibold leading-snug">Read In and Imax correctly</h3>
        </div>
        <ul class="min-w-0 space-y-4 text-sm leading-relaxed text-gray-600">
          <li>
            <strong class="text-gray-900">In (nominal discharge current, 20kA):</strong> the surge
            current the SPD withstands repeatedly. It is tested with repeated impulses, and after
            the test the varistor voltage must stay within ±10%. This is the figure that indicates
            service life.
          </li>
          <li>
            <strong class="text-gray-900">Imax (maximum discharge current, 40kA):</strong> the
            single largest surge the SPD can divert once. It is a safety limit, not a working
            rating. After an Imax-level event, the unit should be inspected and usually replaced.
          </li>
          <li>
            <strong class="text-gray-900">Pole count:</strong> match the protection circuit to the
