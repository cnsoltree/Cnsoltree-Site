---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Img from '@/components/Img.astro';
import { CONTACT } from '@/consts';
import { Image } from 'astro:assets';
import projectsHero from '@/assets/uploads/projects-solar-farm-hero.png';

// ponytail: hand-kept list; add one entry per page in src/pages/projects/. Move to a content collection once there are many.
// kind: 'example' = application example (no specific customer), 'project' = real, customer-approved project.
const items = [
  {
    href: '/projects/steel-combiner-box-multi-string-pv',
    kind: 'example',
    image: '/images/uploads/steel-combiner-box-carport-installed.png',
    alt: 'Steel PV combiner box mounted on a solar carport column with cable tray',
    category: 'PV Combiner Box',
    title: '6-Input Steel Combiner Box for Exposed Multi-String Arrays',
    summary:
      'A lockable steel box that combines six strings into one 125A output for solar carports and other sites with public access.',
    tags: ['6 in / 1 out', '125A', 'Steel · IP65'],
  },
  {
    href: '/projects/plastic-combiner-box-residential-rooftop',
    kind: 'example',
    image: '/images/uploads/ht-8way-rooftop-installed.png',
    alt: 'HT 8-way plastic PV combiner box wall-mounted beside a rooftop solar array',
    category: 'PV Combiner Box',
    title: '2-In / 1-Out Plastic Combiner Box for Residential Rooftops',
    summary:
      'A compact, pre-wired plastic box that combines two rooftop strings into one inverter input, reordered under one part number.',
    tags: ['2 in / 1 out', '600V DC', 'Plastic · IP65'],
  },
];
---

<BaseLayout
  title="Projects & Application Examples"
  description="Soltree PV combiner box and electrical protection configurations for solar carports, rooftops and multi-string PV arrays, with specifications and the components used."
  path="/projects"
>
  <section class="relative isolate overflow-hidden bg-[#102c24] text-white">
    <Image
      src={projectsHero}
      alt=""
      widths={[768, 1280, 2048]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="container py-14 sm:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-green-200">
        <a href="/" class="hover:text-white">
          Home
        </a>
        <span class="mx-3" aria-hidden="true">
          /
        </span>
        <span class="text-white">Projects</span>
      </nav>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">
        Projects & Application Examples
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-200">
        How our combiner boxes and protection devices are configured for real installation
        conditions, including the requirements, the components inside and the specifications.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col overflow-hidden rounded-xl border border-[#dfe8e1] bg-white transition hover:shadow-md"
        >
          <Img
            src={item.image}
            alt={item.alt}
            width={700}
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
              <span class="rounded-full bg-[#edf3ee] px-3 py-1 text-green-800">
                {item.category}
              </span>
              <span class="text-gray-500">
                {item.kind === 'example' ? 'Application example' : 'Customer project'}
              </span>
            </div>
            <h2 class="mt-4 text-xl font-bold leading-snug text-[#18392c] group-hover:text-green-800">
              {item.title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">{item.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold text-gray-600">
              {item.tags.map((tag) => (
                <li class="rounded-md border border-gray-200 px-2.5 py-1">{tag}</li>
              ))}
            </ul>
            <p class="mt-5 text-sm font-semibold text-green-800">
              Read more <span aria-hidden="true">→</span>
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-[#edf3ee] py-14">
    <div class="container flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-[#18392c]">Have a project in mind?</h2>
        <p class="mt-2 text-gray-600">
          Send your drawing or string plan to
          <a href={`mailto:${CONTACT.email}`} class="font-semibold text-green-800 underline">
            {CONTACT.email}
          </a>
          .
        </p>
      </div>
      <a href="/contact" class="btn-primary-lg shrink-0 self-start sm:self-auto">
        Get a quote
      </a>
    </div>
  </section>
</BaseLayout>
