---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Catalog from '@/components/Catalog.astro';
import { t, translatedLangs, type Lang } from '@/i18n';
export function getStaticPaths() {
  return translatedLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---

<BaseLayout
  title={t(lang, 'Products')}
  description={t(
    lang,
    'Browse Soltree electrical products by family: circuit protection, switching, solar PV, metering, enclosures and fire suppression.',
  )}
>
  <Catalog />
</BaseLayout>
